<Project>
  <PropertyGroup>
    <!-- The one version for every assembly. Release: bump it in a pull request, then tag the merge commit v<Version>;
         the release workflow refuses a tag that doesn't match. 1.0.0 matches the MSIX package's existing default
         (packaging/msix/build-msix.ps1, which now reads this), since the Store only accepts increasing versions. -->
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the Windows-specific projects build (not run) on Linux/macOS, e.g. in CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SamaatWindowsTfm>net10.0-windows10.0.19041.0</SamaatWindowsTfm>
  </PropertyGroup>
</Project>
