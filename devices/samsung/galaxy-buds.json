    "namePattern": "Galaxy Buds \\("
  },
  "verified": false,
  "features": ["battery.left", "battery.right", "noise.transparency", "eq.presets"],
  "verifiedFirmware": [],
  "notes": "Works with Galaxy Buds over Samsung's RFCOMM protocol, ported from GalaxyBudsClient. Battery only (left and right) for now. Not yet verified on hardware; see docs/decisions/2026-11-06-samsung-galaxy-buds-port.md."
