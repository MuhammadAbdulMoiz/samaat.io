<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Samaat.Mobile.ViewModels"
             xmlns:views="using:Samaat.Mobile.Views"
             xmlns:uilogo="using:Samaat.UI"
             x:Class="Samaat.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Classes="shell">
  <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,12,12,8" MinHeight="48">
      <Button Classes="icon" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" Margin="0,0,8,0"
              AutomationProperties.Name="Back">
        <PathIcon Data="{StaticResource Icon.Chevron}" RenderTransform="rotate(90deg)" />
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,0,0">
        <Image Source="{x:Static uilogo:Logo.Image}" Width="32" Height="32" IsVisible="{Binding ShowBrand}" AutomationProperties.Name="Samaat" />
        <TextBlock Text="{Binding Title}" Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="2" Classes="icon" Command="{Binding RefreshCommand}" IsVisible="{Binding IsEarbuds}"
              AutomationProperties.Name="Refresh devices">
        <PathIcon Data="{StaticResource Icon.Refresh}" />
      </Button>
    </Grid>

    <!-- Something blocks Samaat: say what, and offer the fix -->
    <Border Grid.Row="1" Classes="alert" Margin="16,0,16,8" IsVisible="{Binding HasBanner}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" />
          <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="240" />
        </StackPanel>
        <Button Grid.Column="1" Classes="subtle" Content="{Binding BannerAction}" Command="{Binding FixBannerCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="16,4,16,24">

        <!-- Earbuds list -->
        <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding ShowDeviceList}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceItemViewModel">
              <Button Classes="deviceRow" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenCommand}"
                      CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleText}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="iconTile" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Headphones}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ConnectionText}" Classes="meta" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasAlert}">
                      <PathIcon Data="{StaticResource Icon.Warning}" Width="12" Height="12" Classes="alertIcon"
                                Classes.critical="{Binding AlertIsCritical}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding AlertText}" Classes="meta alertText" Classes.critical="{Binding AlertIsCritical}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryValue}" Classes="figure" Classes.low="{Binding SummaryIsLow}"
                               Classes.critical="{Binding SummaryIsCritical}" />
                    <TextBlock Text="{Binding SummaryUnit}" Classes="unit" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="panel" IsVisible="{Binding ShowEmpty}">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <views:DeviceView DataContext="{Binding SelectedDevice}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowDevice}" />

        <views:ComputerView DataContext="{Binding Computer}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsComputer}" />
      </Panel>
    </ScrollViewer>

    <!-- Short messages, above the navigation -->
    <Border Grid.Row="2" Classes="toast" VerticalAlignment="Bottom" Margin="16,0,16,12" IsVisible="{Binding HasMessage}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
          <PathIcon Data="{StaticResource Icon.Dismiss}" Width="14" Height="14" />
        </Button>
      </Grid>
    </Border>

    <!-- Bottom navigation -->
    <Border Grid.Row="3" x:Name="NavBar" Classes="navBar">
      <UniformGrid Columns="2">
        <Button Classes="nav" Classes.selected="{Binding IsEarbuds}" Command="{Binding ShowEarbudsCommand}" Margin="0,0,4,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Headphones}" HorizontalAlignment="Center" />
            <TextBlock Text="Earbuds" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Classes.selected="{Binding IsComputer}" Command="{Binding ShowComputerCommand}" Margin="4,0,0,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Laptop}" HorizontalAlignment="Center" />
            <TextBlock Text="Computer" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
