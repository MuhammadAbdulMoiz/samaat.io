<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Samaat.UI.Controls">
  <!-- The desktop's design system (docs/design/ui-audit.md) at phone sizes: 44 px touch targets, 15 px body text. -->

  <Style Selector="UserControl.shell">
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.alertText">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.alertText.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="PathIcon.alertIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="PathIcon.alertIcon.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.PanelEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,10" />
  </Style>
  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Border.iconTile PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Border.iconTile.on">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.iconTile.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>

  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.Faint}" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <Style Selector="Border.alert">
    <Setter Property="Background" Value="{DynamicResource Samaat.WarnSoft}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.alert TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert.critical">
    <Setter Property="Background" Value="{DynamicResource Samaat.CriticalSoft}" />
  </Style>
  <Style Selector="Border.alert.critical TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Border.alert.critical PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- Buttons: 44 px high -->
  <Style Selector="Button.primary, Button.subtle, Button.ghost, Button.icon">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button.primary, Button.subtle">
    <Setter Property="Padding" Value="16,0" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter, Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Key}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Device rows on the list -->
  <Style Selector="Button.deviceRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="MinHeight" Value="72" />
  </Style>
  <Style Selector="Button.deviceRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.PanelEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.deviceRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Options: noise modes and EQ presets -->
  <Style Selector="Button.option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.option /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.option:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.option.selected /template/ ContentPresenter#PART_ContentPresenter, Button.option.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Bottom navigation -->
  <Style Selector="Border.navBar">
    <Setter Property="Background" Value="{DynamicResource Samaat.Rail}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.AccentSoft}" />
  </Style>
  <Style Selector="Button.nav.selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <Style Selector="ProgressBar.level">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>
  <Style Selector="ProgressBar.busy">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The desktop's figures: value and unit apart; low and critical colour the number and the bar, and always come with words -->
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="2,0,0,5" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="TextBlock.figure.low">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="TextBlock.figure.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="ProgressBar.level.low">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="ProgressBar.level.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>

  <!-- Icon tiles in option rows and cards (desktop Controls.axaml) -->
  <Style Selector="Border.optionIcon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Border.optionIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Border.optionIcon.on">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.optionIcon.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <!-- Muted text on accent-soft is 4.45:1 in dark mode, just under AA, so a selected row's description uses the text colour. -->
  <Style Selector="Button.option.selected TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.option.selected Border.optionIcon">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.option.selected Border.optionIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
</Styles>
