<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Samaat.App.Shared.Controls"
        xmlns:overview="using:Samaat.App.Features.Overview">
  <Styles.Resources>
    <!-- A device's own picture when there is one; otherwise a pair of buds, or headphones for a headset -->
    <DataTemplate x:Key="DeviceThumb" x:DataType="overview:DeviceViewModel">
      <Border Classes="deviceThumb">
        <Panel>
          <Image Source="{Binding ArtworkImage}" IsVisible="{Binding HasArtworkImage}" Width="28" Height="28"
                 Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HasBuds" />
                <Binding Path="!HasArtworkImage" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <Viewbox Height="18"><Canvas Width="40" Height="56"><Path Classes="thumbGlyph" Data="{StaticResource Glyph.Bud}" /></Canvas></Viewbox>
            <Viewbox Height="18" RenderTransform="scaleX(-1)"><Canvas Width="40" Height="56"><Path Classes="thumbGlyph" Data="{StaticResource Glyph.Bud}" /></Canvas></Viewbox>
          </StackPanel>
          <PathIcon Classes="thumbGlyph" Data="{StaticResource Icon.Headphones}" Width="18" Height="18">
            <PathIcon.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!HasBuds" />
                <Binding Path="!HasArtworkImage" />
              </MultiBinding>
            </PathIcon.IsVisible>
          </PathIcon>
        </Panel>
      </Border>
    </DataTemplate>
  </Styles.Resources>

  <!-- Sidebar: labelled and 240 wide; the window collapses it to a 68 px icon rail (class "compact") -->
  <Style Selector="Border.sidebar">
    <Setter Property="Width" Value="240" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Rail}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.sidebar.compact">
    <Setter Property="Width" Value="68" />
  </Style>
  <Style Selector="Border.sidebar.compact :is(Control).full">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.sidebar.compact StackPanel.chipRow">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sidebarToggle PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.sidebarToggle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.sidebarToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>

  <!-- Device thumbnails in the sidebar: the product photo, or bud glyphs -->
  <Style Selector="Border.deviceThumb">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.deviceRow.current Border.deviceThumb">
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Path.thumbGlyph">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="PathIcon.thumbGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.deviceRow.current Path.thumbGlyph">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.deviceRow.current PathIcon.thumbGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.sidebar:not(.compact) :is(Control).compactOnly">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Button.nav, Button.deviceRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.sidebar.compact Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.deviceRow">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.sidebar.compact Button.deviceRow">
    <Setter Property="Padding" Value="4,6" />
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter, Button.deviceRow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.deviceRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Button.nav.current /template/ ContentPresenter#PART_ContentPresenter, Button.deviceRow.current /template/ ContentPresenter#PART_ContentPresenter, Button.nav.current:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.deviceRow.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.AccentSoft}" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav.current PathIcon, Button.deviceRow.current Border.initials PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.nav.current TextBlock, Button.deviceRow.current TextBlock.name">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.initials">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Button.deviceRow.current Border.initials">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.deviceRow.current Border.initials TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>

  <!-- Alert counter: a real state, so it may use a status colour -->
  <Style Selector="Button.alertChip">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sidebar.compact Button.alertChip">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.alertChip /template/ ContentPresenter#PART_ContentPresenter, Button.alertChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.WarnSoft}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.alertChip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.alertChip PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.PanelEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8,6,8" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
  </Style>

  <!-- Device filter beside Refresh: on the right when labelled, under Refresh in the icon rail -->
  <Style Selector="DockPanel.refreshRow Button.filterButton">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <Style Selector="Border.sidebar.compact DockPanel.refreshRow Button.filterButton">
    <Setter Property="DockPanel.Dock" Value="Bottom" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="Border.sidebar:not(.compact) Button#LayoutButton">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Focus: one centred column; More pages get a wider one -->
  <Style Selector="StackPanel.focusColumn">
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="StackPanel.focusColumn.wide">
    <Setter Property="MaxWidth" Value="960" />
  </Style>
  <Style Selector="Viewbox.focusStage">
    <Setter Property="MaxHeight" Value="320" />
  </Style>
  <Style Selector="Button.focusMore">
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- Glance cards -->
  <Style Selector="StackPanel.glanceFigure.unreported TextBlock.number">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
</Styles>
