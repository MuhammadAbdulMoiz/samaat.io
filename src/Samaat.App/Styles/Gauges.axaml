<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Samaat.UI.Controls">
  <!-- The artwork styles themselves live in Samaat.UI (Styles/Artwork.axaml), shared with the phone. -->

  <!-- Reduced motion (class set on the window): values jump instead of gliding -->
  <Style Selector="Window.reduce-motion ui|BatteryRing">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <Style Selector="Window.reduce-motion ProgressBar.level">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
</Styles>
