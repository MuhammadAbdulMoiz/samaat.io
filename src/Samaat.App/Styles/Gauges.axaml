<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Samaat.UI.Controls">
  <!-- The artwork styles themselves live in Samaat.UI (Styles/Artwork.axaml), shared with the phone. -->

  <!-- Reduced motion (class set on the window): values jump instead of gliding -->
  <Style Selector="Window.reduce-motion ui|BatteryRing">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
  <!-- Reduced motion keeps comprehension and drops movement: the busy bar holds still, presses don't shrink -->
  <Style Selector="Window.reduce-motion ProgressBar.busy">
    <Setter Property="IsIndeterminate" Value="False" />
    <Setter Property="Value" Value="100" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Window.reduce-motion Button:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.reduce-motion ProgressBar.level">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
  </Style>
</Styles>
