<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Samaat.App.Shared.Controls">

  <!-- Segmented tabs: an inset well with a raised selected key. Used for the device tabs and for choices in Settings. -->
  <Style Selector="Border.tabWell">
    <Setter Property="Background" Value="{DynamicResource Samaat.Well}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Panel}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.Control}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Tab}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Button.tab TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.tab PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter, Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Key}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.PanelEdge}" />
    <Setter Property="BoxShadow" Value="{StaticResource Samaat.Shadow.Key}" />
  </Style>
  <Style Selector="Button.tab.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab.selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Disclosure rows for collapsed sections: a plain toggle with no expand animation, so reduce-motion needs no special case -->
  <Style Selector="ToggleButton.disclosure">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.Control}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.disclosure PathIcon.chevron">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked PathIcon.chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- Selectable option rows (noise control modes) -->
  <Style Selector="Button.option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.OptionRow}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
  </Style>
  <Style Selector="Button.option /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Button.option.selected /template/ ContentPresenter#PART_ContentPresenter, Button.option.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.optionIcon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Border.optionIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Border.optionIcon.on">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.optionIcon.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <!-- A selected row's description uses the text colour, so the row reads as chosen without a coloured fill -->
  <Style Selector="Button.option.selected TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.option.selected Border.optionIcon">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.option.selected Border.optionIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>

  <!-- Accent swatches in Settings: 32 px round targets, a ring and a check on the chosen one -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.swatch /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter, Button.swatch.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="PathIcon.swatchCheck">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Samaat.Swatch.Check}" />
  </Style>

  <!-- Feature cells on Diagnostics: a light key per working feature -->
  <Style Selector="Border.featureCell">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.OptionRow}" />
  </Style>

  <!-- Copy buttons inside detail rows: a quiet 32 px icon button -->
  <Style Selector="Button.copy PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.copy /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>

  <!-- Battery tiles on the Overview: a raised key per component; unreported ones are an outline only -->
  <Style Selector="Border.figureTile">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Tile}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.figureTile.unreported">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- One tile (only Lowest bud is reported) stays tile-sized instead of stretching across the panel -->
  <Style Selector="ItemsControl.figures.single">
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="StackPanel.cell.unreported TextBlock.figure">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>

  <Style Selector="Border.host.active">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>

  <!-- Disabled filled buttons dim like a disabled switch, so a pending request reads as "wait", not "broken" -->
  <Style Selector="Button.subtle:disabled, Button.primary:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Thin indeterminate bar while a command is waiting for the device -->
  <Style Selector="ProgressBar.busy">
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Level bars under battery figures -->
  <Style Selector="ProgressBar.level">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Hairline}" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="ProgressBar.level.low">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="ProgressBar.level.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="ProgressBar.level">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.26">
          <DoubleTransition.Easing><SplineEasing X1="0.23" Y1="1" X2="0.32" Y2="1" /></DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
  </Style>

  <!-- Share audio rows: the option-row anatomy as a Border, since it holds interactive controls -->
  <Style Selector="Border.shareRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.OptionRow}" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Border.shareRow.sharing">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.shareRow.sharing Border.optionIcon">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.shareRow.sharing Border.optionIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="Border.shareRow Button.ghost">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Border.shareRow Button.ghost:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.shareRow Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Ellipse.liveDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Same 36x20 switch with a transparent 32 px hit area -->
  <Style Selector="ToggleSwitch.share">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" MinHeight="32" Padding="0,6">
          <Border Name="Track" Width="36" Height="20" CornerRadius="{StaticResource Samaat.Radius.Round20}" BorderThickness="1" Background="Transparent"
                  BorderBrush="{DynamicResource Samaat.Faint}">
            <Panel Name="PART_MovingKnobs">
              <Ellipse Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Samaat.Muted}" />
            </Panel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Settings: layout cards with a small sketch of each layout, drawn with the theme's own brushes -->
  <Style Selector="Button.layoutCard">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Panel}" />
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.Control}" />
  </Style>
  <Style Selector="Button.layoutCard /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.layoutCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.layoutCard.selected /template/ ContentPresenter#PART_ContentPresenter, Button.layoutCard.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.layoutCard TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.layoutCard TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="PathIcon.layoutCheck">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.layoutSketch">
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.sk">
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Hairline}" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Key}" />
  </Style>
  <Style Selector="Border.sk.card">
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.sk.accent">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
</Styles>
