<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Samaat.App.Shared.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Body}" />
  </Style>

  <!-- Type: page title 22, panel title 15, body 13, meta 12, figures 30 at weight 600 -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.PanelTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Figure}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="2,0,0,5" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <!-- Small group heading inside a panel, e.g. "Device" and "Connection" on Details -->
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Meta}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>

  <!-- Panels: a surface with a subtle lit edge, never nested -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.PanelEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Panel}" />
    <Setter Property="Padding" Value="{StaticResource Samaat.Padding.Panel}" />
  </Style>
  <!-- A quiet inset strip for a state or a note inside a panel, e.g. "Playing on" and the adapter note -->
  <Style Selector="Border.strip">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Padding" Value="{StaticResource Samaat.Padding.Strip}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Border}" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.Row}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,8" />
  </Style>

  <!-- Chips: status words, never decoration -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Meta}" />
  </Style>
  <!-- 12,8 makes a one-line alert 32 px tall, the same as the buttons beside it -->
  <Style Selector="Border.alert">
    <Setter Property="Background" Value="{DynamicResource Samaat.WarnSoft}" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- Alert and error messages: meta size, semibold, in the status colour -->
  <Style Selector="Border.alert TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Samaat.FontSize.Meta}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert.critical">
    <Setter Property="Background" Value="{DynamicResource Samaat.CriticalSoft}" />
  </Style>
  <Style Selector="Border.alert.critical TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Border.alert.critical PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>

  <!-- A dot only ever shows a real state: connected (accent) or not (faint) -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.Faint}" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Buttons: 32 px high, radius 6 -->
  <Style Selector="Button.icon, Button.subtle, Button.primary, Button.ghost">
    <Setter Property="MinHeight" Value="{StaticResource Samaat.Size.Control}" />
    <Setter Property="CornerRadius" Value="{StaticResource Samaat.Radius.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Press feedback: a slight shrink while held, 160 ms on a strong ease-out. Reduce motion drops it (Gauges.axaml). -->
  <Style Selector="Button.icon, Button.subtle, Button.primary, Button.ghost, Button.option, Button.layoutCard">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
          <TransformOperationsTransition.Easing><SplineEasing X1="0.23" Y1="1" X2="0.32" Y2="1" /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pressed, Button.subtle:pressed, Button.primary:pressed, Button.ghost:pressed, Button.option:pressed, Button.layoutCard:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.subtle, Button.primary">
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter, Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Key}" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>

  <!-- Unselected text on a coloured fill never goes below AA: icons follow the text colour -->
  <Style Selector="Button.subtle TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Switches: 36x20 -->
  <Style Selector="ToggleSwitch">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Track" Width="36" Height="20" CornerRadius="{StaticResource Samaat.Radius.Round20}" BorderThickness="1" Background="Transparent"
                BorderBrush="{DynamicResource Samaat.Faint}">
          <Panel Name="PART_MovingKnobs">
            <Ellipse Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Samaat.Muted}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#Track">
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="ToggleSwitch:disabled /template/ Border#Track">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</Styles>
