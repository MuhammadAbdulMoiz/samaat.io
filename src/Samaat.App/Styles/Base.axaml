<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Samaat.App.Shared.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!-- Chips and pills -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.alert">
    <Setter Property="Background" Value="{DynamicResource Samaat.WarnSoft}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Border.alert TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert.critical">
    <Setter Property="Background" Value="{DynamicResource Samaat.CriticalSoft}" />
  </Style>
  <Style Selector="Border.alert.critical TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Border.alert.critical PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.Faint}" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Border.ledgerRow">
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
</Styles>
