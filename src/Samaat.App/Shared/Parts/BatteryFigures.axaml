<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             xmlns:c="using:Samaat.App.Shared.Controls"
             x:Class="Samaat.App.Shared.Parts.BatteryFigures"
             x:DataType="overview:DeviceViewModel">
  <!-- Lowest bud, left, right and case as tiles; "–" where the device reports nothing. Overview and Focus both use it. -->
  <ItemsControl Classes="figures" Classes.single="{Binding !ShowsComponentFigures}" ItemsSource="{Binding ShownFigures}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><c:AdaptiveColumns MinColumnWidth="128" MaxColumns="4" Spacing="8" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="overview:BatteryFigureViewModel">
        <Border Classes="figureTile" Classes.unreported="{Binding !IsReported}" AutomationProperties.Name="{Binding AccessibleText}">
          <StackPanel Classes="cell" Classes.unreported="{Binding !IsReported}" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Label}" Classes="meta" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" MinHeight="16" VerticalAlignment="Center">
                <Image Source="{Binding Photo}" Height="24" MaxWidth="32" Stretch="Uniform" IsVisible="{Binding Photo, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- No photo of this part: the mystery piece instead -->
                <Image Source="avares://Samaat.UI/Assets/Unknown/unknown-bud.png" Height="24" Stretch="Uniform" IsVisible="{Binding ShowsUnknownBud}" />
                <Image Source="avares://Samaat.UI/Assets/Unknown/unknown-case.png" Height="18" Stretch="Uniform" IsVisible="{Binding ShowsUnknownCase}" />
                <PathIcon Data="{StaticResource Icon.BatteryCharge}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Accent}"
                          IsVisible="{Binding IsCharging}" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="figure" Text="{Binding Value}" />
              <TextBlock Classes="unit" Text="{Binding Unit}" />
            </StackPanel>
            <ProgressBar Classes="level" Classes.low="{Binding IsLow}" Classes.critical="{Binding IsCritical}"
                         Minimum="0" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding HasLevel}" />
            <TextBlock Text="{Binding Meta}" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
