<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0 runs anywhere with the simulator; the Windows TFM adds real Bluetooth. -->
    <TargetFrameworks>net10.0;$(SamaatWindowsTfm)</TargetFrameworks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest Condition="'$(TargetFramework)' != 'net10.0'">app.manifest</ApplicationManifest>
    <AssemblyName>Samaat</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);SAMAAT_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\devices\**\*.json" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\devices\**\*.png" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Core\Samaat.Core.csproj" />
    <ProjectReference Include="..\Samaat.Protocols.Jieli\Samaat.Protocols.Jieli.csproj" />
    <ProjectReference Include="..\Samaat.Protocols.FastPair\Samaat.Protocols.FastPair.csproj" />
    <ProjectReference Include="..\Samaat.Simulator\Samaat.Simulator.csproj" />
    <ProjectReference Include="..\Samaat.Platform.Windows\Samaat.Platform.Windows.csproj" Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\devices\**\*.json" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
