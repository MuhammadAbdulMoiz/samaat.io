<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Samaat.App.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Samaat.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!-- Chips and pills -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.alert">
    <Setter Property="Background" Value="{DynamicResource Samaat.WarnSoft}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Border.alert TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Border.alert.critical">
    <Setter Property="Background" Value="{DynamicResource Samaat.CriticalSoft}" />
  </Style>
  <Style Selector="Border.alert.critical TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Border.alert.critical PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Samaat.Faint}" />
  </Style>
  <Style Selector="Ellipse.dot.on">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <!-- Navigation rail -->
  <Style Selector="Button.nav">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.nav TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Samaat.AccentSoft}" />
  </Style>
  <Style Selector="Button.nav.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.nav:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Faint}" />
  </Style>
  <Style Selector="Button.nav:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Faint}" />
  </Style>

  <!-- Device switcher -->
  <Style Selector="ListBox.devices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="ListBox.devices ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Text}" />
  </Style>

  <Style Selector="ProgressBar.mini">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="ProgressBar.mini.low">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>

  <!-- Battery gauges -->
  <Style Selector="c|BatteryRing">
    <Setter Property="TrackBrush" Value="{DynamicResource Samaat.Track}" />
    <Setter Property="ValueBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="c|BatteryRing.low">
    <Setter Property="ValueBrush" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="c|BatteryRing.critical">
    <Setter Property="ValueBrush" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="StackPanel.gauge.unavailable">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBlock.state">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="TextBlock.state.low">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="TextBlock.state.critical">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Critical}" />
  </Style>
  <Style Selector="TextBlock.stale">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Warn}" />
  </Style>
  <Style Selector="Path.glyph">
    <Setter Property="Fill" Value="{DynamicResource Samaat.Glyph}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Path.glyphDetail">
    <Setter Property="Fill" Value="{DynamicResource Samaat.GlyphDetail}" />
    <Setter Property="Stroke" Value="{DynamicResource Samaat.GlyphDetail}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Mode cards and segments -->
  <Style Selector="Button.modeCard">
    <Setter Property="Width" Value="196" />
    <Setter Property="Height" Value="136" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.modeCard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
  </Style>
  <Style Selector="Button.modeCard.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.modeCard.selected Border.modeIcon">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.modeCard.selected Border.modeIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="Border.modeIcon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
  </Style>
  <Style Selector="Border.modeIcon PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Border.modeIcon.on">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Border.modeIcon.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.segment PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.Muted}" />
  </Style>
  <Style Selector="Button.segment.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>
  <Style Selector="Button.segment.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="Button.segment.selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Samaat.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Samaat.OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Border.host.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Accent}" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Samaat.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Samaat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8,6,8" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
  </Style>
</Styles>
