<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:info="using:Samaat.App.Features.Info"
             xmlns:c="using:Samaat.App.Shared.Controls"
             x:Class="Samaat.App.Features.Info.InfoPage"
             x:DataType="overview:DeviceViewModel">
  <StackPanel Spacing="16">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Diagnostics" Classes="panelTitle" />
        <TextBlock Text="What Samaat sees, how it matched your device, and every capability with its source." Classes="meta" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="subtle" Margin="12,0,0,0" Click="OnCopyReport" AutomationProperties.Name="Copy diagnostics report"
              ToolTip.Tip="Copy a report to attach to a hardware bug report">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Text}" />
          <TextBlock x:Name="CopyLabel" Text="Copy report" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Capabilities, grouped by module (the only place every unsupported feature is listed) -->
    <ItemsControl ItemsSource="{Binding CapabilityGroups}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="overview:CapabilityGroupViewModel">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" Classes="panelTitle" />
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Classes="meta" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="overview:CapabilityItemViewModel">
                    <Border Classes="chip" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" IsVisible="{Binding IsEnabled}" Foreground="{DynamicResource Samaat.Accent}" />
                        <PathIcon Data="{StaticResource Icon.Dash}" Width="12" Height="12" IsVisible="{Binding !IsEnabled}" Foreground="{DynamicResource Samaat.Faint}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Classes="muted" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="16" DataContext="{Binding Info}" x:DataType="info:DeviceInfoViewModel">

      <!-- Identity and detection -->
      <c:AdaptiveColumns MinColumnWidth="300" MaxColumns="2" Spacing="16">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Identity" Classes="panelTitle" />
            <ItemsControl ItemsSource="{Binding Identity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="info:InfoRow">
                  <Grid ColumnDefinitions="130,*" Margin="0,3">
                    <TextBlock Text="{Binding Label}" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Detection" Classes="panelTitle" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="dot" Classes.on="{Binding IsDriverMatch}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding VerifiedText}" />
            </StackPanel>
            <TextBlock Text="{Binding ResolutionText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Signals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="info:InfoRow">
                  <Grid ColumnDefinitions="130,*" Margin="0,3">
                    <TextBlock Text="{Binding Label}" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </c:AdaptiveColumns>

      <!-- Capability ledger -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Capability ledger" Classes="panelTitle" />
          <Grid ColumnDefinitions="2*,3*,1.3*,1.1*,0.8*" Margin="0,4,0,0">
            <TextBlock Text="Capability" Classes="meta" />
            <TextBlock Grid.Column="1" Text="State" Classes="meta" />
            <TextBlock Grid.Column="2" Text="Source" Classes="meta" />
            <TextBlock Grid.Column="3" Text="Access" Classes="meta" />
            <TextBlock Grid.Column="4" Text="Verified" Classes="meta" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Ledger}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="info:LedgerRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="2*,3*,1.3*,1.1*,0.8*">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" IsVisible="{Binding IsEnabled}" Foreground="{DynamicResource Samaat.Accent}" />
                      <PathIcon Data="{StaticResource Icon.Dash}" Width="12" Height="12" IsVisible="{Binding !IsEnabled}" Foreground="{DynamicResource Samaat.Faint}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip.Tip="{Binding Feature}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding State}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding State}" />
                    <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" />
                    <TextBlock Grid.Column="3" Text="{Binding Access}" Classes="muted" />
                    <TextBlock Grid.Column="4" Text="✓" IsVisible="{Binding Verified}" Foreground="{DynamicResource Samaat.Accent}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Event log -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Event log" Classes="panelTitle" />
          <TextBlock Text="Waiting for the device to report something…" Classes="meta" IsVisible="{Binding !Events.Count}" />
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="info:EventRow">
                <Grid ColumnDefinitions="80,*" Margin="0,2">
                  <TextBlock Text="{Binding Time}" Classes="number muted" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
