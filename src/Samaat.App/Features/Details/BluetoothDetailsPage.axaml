<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Samaat.App.Features.Details"
             xmlns:ov="using:Samaat.App.Features.Overview"
             x:Class="Samaat.App.Features.Details.BluetoothDetailsPage"
             x:DataType="ov:DeviceViewModel">
  <StackPanel Spacing="20" DataContext="{Binding Details}" x:DataType="vm:BluetoothDetailsViewModel">

    <StackPanel Spacing="4">
      <TextBlock Text="DETAILS" Classes="eyebrow" />
      <TextBlock Text="Bluetooth details" Classes="display" FontSize="32" />
      <TextBlock Text="{Binding IdentifiedText}" Classes="muted" />
    </StackPanel>

    <Border Classes="surface">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DetailsRow">
            <Grid ColumnDefinitions="180,*" Margin="0,6">
              <TextBlock Text="{Binding Label}" Classes="muted" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Classes="surface">
      <StackPanel Spacing="8">
        <TextBlock Text="SUPPORT" Classes="eyebrow" />
        <TextBlock Text="{Binding AdapterText}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Without a vendor adapter, Samaat shows what Windows and standard Bluetooth services report." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
