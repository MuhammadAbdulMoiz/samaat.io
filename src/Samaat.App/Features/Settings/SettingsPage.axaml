<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Samaat.App.Features.Settings"
             xmlns:set="using:Samaat.Core.Settings"
             xmlns:phone="using:Samaat.App.Features.Phone"
             xmlns:c="using:Samaat.App.Shared.Controls"
             xmlns:uilogo="using:Samaat.UI"
             x:Class="Samaat.App.Features.Settings.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <!-- Settings: one panel per topic, every row an icon tile, a label with one line of meaning, and its control -->
  <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

    <StackPanel Spacing="4">
      <TextBlock Text="Settings" Classes="title" />
      <TextBlock Text="Changes apply and save straight away." Classes="muted" />
    </StackPanel>

    <Border Classes="alert critical" IsVisible="{Binding HasError}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
        <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Phone: pair phones running Samaat, to move earbuds between them and this computer -->
    <Border Classes="panel" IsVisible="{Binding PhoneLink, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8" DataContext="{Binding PhoneLink}" x:DataType="phone:PhoneLinkViewModel">
        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Phone" Classes="panelTitle" />
            <TextBlock Text="Move your earbuds between this computer and your Android phone from either one." Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Pair a phone" Command="{Binding PairCommand}" IsVisible="{Binding ShowPairButton}"
                  VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Border Classes="alert critical" IsVisible="{Binding HasError}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Waiting for the phone to dial in -->
        <Border Classes="row" IsVisible="{Binding ShowWaiting}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <ProgressBar Classes="busy" IsIndeterminate="True" />
              <TextBlock Text="{Binding WaitingText}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CancelPairingCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!-- A phone asked: compare the code -->
        <Border Classes="row" IsVisible="{Binding HasRequest}">
          <StackPanel Spacing="8" DataContext="{Binding Request}" x:DataType="phone:PairingPromptViewModel">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Code}" Classes="number" FontSize="32" FontWeight="SemiBold" LetterSpacing="2"
                       AutomationProperties.Name="Pairing code" />
            <TextBlock Text="{Binding Hint}" Classes="meta" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Pair" Command="{Binding AcceptCommand}" IsEnabled="{Binding !IsAnswering}" />
              <Button Classes="ghost" Content="Cancel" Command="{Binding DeclineCommand}" IsEnabled="{Binding !IsAnswering}" />
              <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Paired phones -->
        <ItemsControl ItemsSource="{Binding Phones}" IsVisible="{Binding HasPhones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="phone:PairedPhoneViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
                  <Border Classes="optionIcon" Classes.on="{Binding IsOnline}" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Phone}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Classes="dot" Classes.on="{Binding IsOnline}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StatusText}" Classes="meta" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="subtle" Content="Forget" Command="{Binding ForgetCommand}"
                          AutomationProperties.Name="{Binding ForgetAccessibleName}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

<Border Classes="panel">
<StackPanel Spacing="8">
  <StackPanel Spacing="2" Margin="0,0,0,4">
    <TextBlock Text="Appearance" Classes="panelTitle" />
    <TextBlock Text="How Samaat looks" Classes="meta" />
  </StackPanel>
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Theme}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Mode" />
    <TextBlock Text="Follow Windows, or pick one" Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <Border Grid.Column="2" Classes="tabWell" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Classes="tab" Classes.selected="{Binding IsSystemTheme}" Content="System"
              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static set:ThemeChoice.System}" />
      <Button Classes="tab" Classes.selected="{Binding IsLightTheme}" Content="Light"
              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static set:ThemeChoice.Light}" />
      <Button Classes="tab" Classes.selected="{Binding IsDarkTheme}" Content="Dark"
              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static set:ThemeChoice.Dark}" />
    </StackPanel>
  </Border>
</Grid>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Palette}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Accent" />
    <TextBlock Text="Used for charge, selection and focus" Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
<Button Classes="swatch" Classes.selected="{Binding IsLimeAccent}" AutomationProperties.Name="Lime" ToolTip.Tip="Lime"
        Command="{Binding SetAccentCommand}" CommandParameter="{x:Static set:AccentChoice.Lime}">
  <Panel>
    <Ellipse Fill="#C8F169" Stroke="{DynamicResource Samaat.Border}" StrokeThickness="1" />
    <PathIcon Classes="swatchCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsLimeAccent}" />
  </Panel>
</Button>
<Button Classes="swatch" Classes.selected="{Binding IsEmeraldAccent}" AutomationProperties.Name="Emerald" ToolTip.Tip="Emerald"
        Command="{Binding SetAccentCommand}" CommandParameter="{x:Static set:AccentChoice.Emerald}">
  <Panel>
    <Ellipse Fill="#3DDC97" Stroke="{DynamicResource Samaat.Border}" StrokeThickness="1" />
    <PathIcon Classes="swatchCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsEmeraldAccent}" />
  </Panel>
</Button>
<Button Classes="swatch" Classes.selected="{Binding IsIceAccent}" AutomationProperties.Name="Ice" ToolTip.Tip="Ice"
        Command="{Binding SetAccentCommand}" CommandParameter="{x:Static set:AccentChoice.Ice}">
  <Panel>
    <Ellipse Fill="#6CC4FF" Stroke="{DynamicResource Samaat.Border}" StrokeThickness="1" />
    <PathIcon Classes="swatchCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsIceAccent}" />
  </Panel>
</Button>
<Button Classes="swatch" Classes.selected="{Binding IsMonoAccent}" AutomationProperties.Name="Mono" ToolTip.Tip="Mono"
        Command="{Binding SetAccentCommand}" CommandParameter="{x:Static set:AccentChoice.Mono}">
  <Panel>
    <Ellipse Fill="#E6E9EC" Stroke="{DynamicResource Samaat.Border}" StrokeThickness="1" />
    <PathIcon Classes="swatchCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsMonoAccent}" />
  </Panel>
</Button>
</StackPanel>
</Grid>
</Border>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Sparkle}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Reduce motion" />
    <TextBlock Text="Turns off fades and gliding values. Follows Windows until you change it." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <ToggleSwitch Grid.Column="2" Classes="share" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="Reduce motion" />
</Grid>
</Border>
<Border Classes="row">
<StackPanel Spacing="12">
<Grid ColumnDefinitions="Auto,*" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Layout}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Layout" />
    <TextBlock Text="How the main window is arranged. Ctrl+Shift+1, 2 or 3 switches from anywhere." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
</Grid>
<ItemsControl x:Name="LayoutCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptiveColumns MinColumnWidth="150" MaxColumns="3" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <Button Classes="layoutCard" Classes.selected="{Binding IsStudioView}" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static set:DashboardView.Studio}"
            AutomationProperties.Name="Studio layout: Every control, one device at a time">
      <StackPanel Spacing="8">
        <Border Classes="layoutSketch">
          <Grid ColumnDefinitions="10,22,*" ColumnSpacing="4">
            <Border Classes="sk" />
            <StackPanel Grid.Column="1" Spacing="4"><Border Classes="sk accent" Height="22" CornerRadius="11" /><Border Classes="sk" Height="6" /><Border Classes="sk" Height="6" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><Border Classes="sk" Height="8" /><Border Classes="sk" Height="18" /><Border Classes="sk" Height="14" /></StackPanel>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Studio" FontWeight="SemiBold" />
          <PathIcon Grid.Column="1" Classes="layoutCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsStudioView}" />
        </Grid>
        <TextBlock Text="Every control, one device at a time" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>
    </Button>
    <Button Classes="layoutCard" Classes.selected="{Binding IsFocusView}" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static set:DashboardView.Focus}"
            AutomationProperties.Name="Focus layout: One device, big and simple">
      <StackPanel Spacing="8">
        <Border Classes="layoutSketch">
          <Grid ColumnDefinitions="10,*" ColumnSpacing="4">
            <Border Classes="sk" />
            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
              <Border Classes="sk accent" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4"><Border Classes="sk" Width="14" Height="10" /><Border Classes="sk" Width="14" Height="10" /><Border Classes="sk" Width="14" Height="10" /></StackPanel>
              <Border Classes="sk" Height="6" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Focus" FontWeight="SemiBold" />
          <PathIcon Grid.Column="1" Classes="layoutCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsFocusView}" />
        </Grid>
        <TextBlock Text="One device, big and simple" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>
    </Button>
    <Button Classes="layoutCard" Classes.selected="{Binding IsGlanceView}" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static set:DashboardView.Glance}"
            AutomationProperties.Name="Glance layout: Every device's battery, in a small window">
      <StackPanel Spacing="8">
        <Border Classes="layoutSketch">
          <Grid ColumnDefinitions="6,*,*" RowDefinitions="*,*" ColumnSpacing="4" RowSpacing="4">
            <Border Grid.RowSpan="2" Classes="sk" />
            <Border Grid.Column="1" Classes="sk card"><Border Classes="sk accent" Height="3" VerticalAlignment="Bottom" Margin="0,0,8,0" /></Border>
            <Border Grid.Column="2" Classes="sk card"><Border Classes="sk accent" Height="3" VerticalAlignment="Bottom" Margin="0,0,4,0" /></Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="sk card"><Border Classes="sk accent" Height="3" VerticalAlignment="Bottom" Margin="0,0,14,0" /></Border>
            <Border Grid.Row="1" Grid.Column="2" Classes="sk card"><Border Classes="sk accent" Height="3" VerticalAlignment="Bottom" Margin="0,0,10,0" /></Border>
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Glance" FontWeight="SemiBold" />
          <PathIcon Grid.Column="1" Classes="layoutCheck" Data="{StaticResource Icon.Check}" IsVisible="{Binding IsGlanceView}" />
        </Grid>
        <TextBlock Text="Every device's battery, in a small window" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>
    </Button>
</ItemsControl>
</StackPanel>
</Border>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Filter}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Device list" />
    <TextBlock Text="Which devices the sidebar shows. Recent means connected in the last 7 days." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <Border Grid.Column="2" Classes="tabWell" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Classes="tab" Classes.selected="{Binding IsConnectedFilter}" Content="Connected"
              Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static set:DeviceFilter.Connected}" />
      <Button Classes="tab" Classes.selected="{Binding IsRecentFilter}" Content="Recent"
              Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static set:DeviceFilter.Recent}" />
      <Button Classes="tab" Classes.selected="{Binding IsPairedFilter}" Content="All paired"
              Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static set:DeviceFilter.Paired}" />
    </StackPanel>
  </Border>
</Grid>
</Border>
</StackPanel>
</Border>
<Border Classes="panel">
<StackPanel Spacing="8">
  <StackPanel Spacing="2" Margin="0,0,0,4">
    <TextBlock Text="Battery alerts" Classes="panelTitle" />
    <TextBlock Text="When Samaat warns you about a low battery" Classes="meta" />
  </StackPanel>
<StackPanel Spacing="4">
  <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
    <Border Classes="optionIcon" VerticalAlignment="Center">
      <PathIcon Data="{StaticResource Icon.BatteryWarning}" Width="16" Height="16" />
    </Border>
    <TextBlock Grid.Column="1" Text="Low battery warning" Margin="12,0" VerticalAlignment="Center" />
    <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
      <TextBlock Text="{Binding LowThreshold, StringFormat={}{0:0}%}" Classes="number" />
    </Border>
  </Grid>
  <Slider Margin="44,-8,0,-4" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
          Value="{Binding LowThreshold}" AutomationProperties.Name="Low battery warning" />
</StackPanel>
<Border Classes="row">
<StackPanel Spacing="4">
  <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
    <Border Classes="optionIcon" VerticalAlignment="Center">
      <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" />
    </Border>
    <TextBlock Grid.Column="1" Text="Critical battery warning" Margin="12,0" VerticalAlignment="Center" />
    <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
      <TextBlock Text="{Binding CriticalThreshold, StringFormat={}{0:0}%}" Classes="number" />
    </Border>
  </Grid>
  <Slider Margin="44,-8,0,-4" Minimum="1" Maximum="{Binding CriticalMax}" TickFrequency="1" IsSnapToTickEnabled="True"
          Value="{Binding CriticalThreshold}" AutomationProperties.Name="Critical battery warning" />
</StackPanel>
</Border>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.BatteryCharge}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Include the charging case" />
    <TextBlock Text="A low case is less urgent than low buds, so it is off by default." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <ToggleSwitch Grid.Column="2" Classes="share" IsChecked="{Binding IncludeCase}" AutomationProperties.Name="Include the charging case" />
</Grid>
</Border>
</StackPanel>
</Border>
<Border Classes="panel">
<StackPanel Spacing="8">
  <StackPanel Spacing="2" Margin="0,0,0,4">
    <TextBlock Text="Background" Classes="panelTitle" />
    <TextBlock Text="What Samaat does when the window is closed" Classes="meta" />
  </StackPanel>
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Bell}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="System notifications" />
    <TextBlock Text="Also show battery alerts as system notifications." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <ToggleSwitch Grid.Column="2" Classes="share" IsChecked="{Binding SystemNotifications}" AutomationProperties.Name="System notifications" />
</Grid>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Window}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Keep running in the tray" />
    <TextBlock Text="Closing the window hides Samaat instead of quitting." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
  <ToggleSwitch Grid.Column="2" Classes="share" IsChecked="{Binding CloseToTray}" AutomationProperties.Name="Keep running in the tray" />
</Grid>
</Border>
<Border Classes="row">
<Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
  <Border Classes="optionIcon" VerticalAlignment="Center">
    <PathIcon Data="{StaticResource Icon.Power}" Width="16" Height="16" />
  </Border>
  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
    <TextBlock Text="Start with Windows" />
    <TextBlock Text="Opens Samaat minimized when you sign in." Classes="meta" TextWrapping="Wrap" />
    <TextBlock Text="{Binding StartupNote}" Classes="meta" IsVisible="{Binding !StartupSupported}" />
  </StackPanel>
  <ToggleSwitch Grid.Column="2" Classes="share" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding StartupSupported}" AutomationProperties.Name="Start with Windows" />
</Grid>
</Border>
</StackPanel>
</Border>
<Border Classes="panel">
<Grid ColumnDefinitions="Auto,*">
  <Image Source="{x:Static uilogo:Logo.Image}" Width="40" Height="40" VerticalAlignment="Top" AutomationProperties.Name="Samaat logo" />
  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
    <TextBlock Text="Samaat" Classes="display" FontSize="16" />
    <TextBlock Text="{Binding VersionText}" Classes="meta" />
    <TextBlock Text="A companion for Bluetooth earbuds from any brand." Classes="meta" TextWrapping="Wrap" />
  </StackPanel>
</Grid>
</Border>
  </StackPanel>
</UserControl>
