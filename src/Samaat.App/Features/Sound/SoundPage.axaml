<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             xmlns:sound="using:Samaat.App.Features.Sound"
             x:Class="Samaat.App.Features.Sound.SoundPage"
             x:DataType="overview:DeviceViewModel">
  <StackPanel Spacing="16">
  <StackPanel Spacing="16" DataContext="{Binding NoiseControl}" x:DataType="sound:NoiseControlViewModel">

    <!-- Mode -->
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="-16,-16,-16,0" />
        <TextBlock Text="Noise control" Classes="panelTitle" />

        <!-- Several modes: one selectable row per mode -->
        <ItemsControl ItemsSource="{Binding Modes}" IsVisible="{Binding IsSelector}" IsEnabled="{Binding CanControl}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sound:NoiseModeOptionViewModel">
              <Button Classes="option" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                      AutomationProperties.Name="{Binding Label}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="optionIcon">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="meta" TextWrapping="Wrap" />
                  </StackPanel>
                  <PathIcon Grid.Column="2" Data="{StaticResource Icon.Check}" Width="14" Height="14" VerticalAlignment="Center"
                            Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding IsSelected}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Noise cancelling on/off only -->
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding IsToggle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Noise cancelling" />
            <TextBlock Text="This model has a single on/off switch for noise cancelling." Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAncOn}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Noise cancelling" />
        </Grid>

        <!-- Nothing to control -->
        <StackPanel IsVisible="{Binding IsUnavailable}" Spacing="2">
          <TextBlock Text="Noise control unavailable" />
          <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel IsVisible="{Binding !IsUnavailable}">
          <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border Classes="alert critical" IsVisible="{Binding HasError}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
              <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Levels -->
    <Border Classes="panel" IsVisible="{Binding ShowAncLevel}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Noise cancelling strength" Classes="panelTitle" />
          <TextBlock Grid.Column="1" Text="{Binding AncLevel, StringFormat='{}{0:0}'}" Classes="number panelTitle" />
        </Grid>
        <Slider Minimum="{Binding AncMin}" Maximum="{Binding AncMax}" Value="{Binding AncLevel}" IsEnabled="{Binding CanControl}"
                TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Noise cancelling strength" />
        <TextBlock Text="Lower it if you hear pressure or hiss in quiet rooms." Classes="meta" />
      </StackPanel>
    </Border>
    <Border Classes="panel" IsVisible="{Binding ShowAmbientLevel}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Ambient sound level" Classes="panelTitle" />
          <TextBlock Grid.Column="1" Text="{Binding AmbientLevel, StringFormat='{}{0:0}'}" Classes="number panelTitle" />
        </Grid>
        <Slider Minimum="{Binding AmbientMin}" Maximum="{Binding AmbientMax}" Value="{Binding AmbientLevel}" IsEnabled="{Binding CanControl}"
                TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Ambient sound level" />
        <TextBlock Text="How much of your surroundings passes through." Classes="meta" />
      </StackPanel>
    </Border>

    <!-- Extras -->
    <Border Classes="panel" IsVisible="{Binding HasExtras}">
      <StackPanel Spacing="8">
        <TextBlock Text="Extras" Classes="panelTitle" />
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding ShowWind}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Wind noise reduction" />
            <TextBlock Text="Cuts the rumble of wind on the microphones." Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding WindReduction}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Wind noise reduction" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding ShowConversation}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Conversation awareness" />
            <TextBlock Text="Lowers your audio and lets voices through when you start talking." Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConversationAwareness}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Conversation awareness" />
        </Grid>
      </StackPanel>
    </Border>

  </StackPanel>

  <!-- Equalizer -->
  <Border Classes="panel" DataContext="{Binding Equalizer}" x:DataType="sound:EqualizerViewModel">
    <StackPanel Spacing="12">
      <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="-16,-16,-16,0" />
      <StackPanel>
        <TextBlock Text="Equalizer" Classes="panelTitle" />
        <TextBlock Text="Presets stored on the earbuds" Classes="meta" IsVisible="{Binding !IsUnavailable}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Presets}" IsVisible="{Binding !IsUnavailable}" IsEnabled="{Binding CanControl}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sound:EqPresetOptionViewModel">
            <Button Classes="option" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                    AutomationProperties.Name="{Binding Label}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <PathIcon Grid.Column="1" Data="{StaticResource Icon.Check}" Width="14" Height="14" VerticalAlignment="Center"
                          Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding IsSelected}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding IsUnavailable}" Spacing="2">
        <TextBlock Text="Equalizer unavailable" />
        <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel IsVisible="{Binding !IsUnavailable}">
        <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="alert critical" IsVisible="{Binding HasError}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </Border>
  </StackPanel>
</UserControl>
