<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             xmlns:sound="using:Samaat.App.Features.Sound"
             xmlns:audio="using:Samaat.Core.Audio"
             x:Class="Samaat.App.Features.Sound.SoundPage"
             x:DataType="overview:DeviceViewModel">
  <StackPanel Spacing="16">
  <StackPanel Spacing="16" DataContext="{Binding NoiseControl}" x:DataType="sound:NoiseControlViewModel">

    <!-- Mode -->
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}" Margin="-16,-16,-16,0" />
        <TextBlock Text="Noise control" Classes="panelTitle" />

        <!-- Several modes: one selectable row per mode -->
        <ItemsControl ItemsSource="{Binding Modes}" IsVisible="{Binding IsSelector}" IsEnabled="{Binding CanControl}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sound:NoiseModeOptionViewModel">
              <Button Classes="option" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                      AutomationProperties.Name="{Binding Label}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="optionIcon">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="meta" TextWrapping="Wrap" />
                  </StackPanel>
                  <PathIcon Grid.Column="2" Data="{StaticResource Icon.Check}" Width="14" Height="14" VerticalAlignment="Center"
                            Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding IsSelected}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Noise cancelling on/off only -->
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding IsToggle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Noise cancelling" />
            <TextBlock Text="This model has a single on/off switch for noise cancelling" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAncOn}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Noise cancelling" />
        </Grid>

        <!-- Nothing to control -->
        <StackPanel IsVisible="{Binding IsUnavailable}" Spacing="2">
          <TextBlock Text="Noise control unavailable" />
          <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel IsVisible="{Binding !IsUnavailable}">
          <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border Classes="alert critical" IsVisible="{Binding HasError}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
              <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Levels -->
    <Border Classes="panel" IsVisible="{Binding ShowAncLevel}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Noise cancelling strength" Classes="panelTitle" />
          <TextBlock Grid.Column="1" Text="{Binding AncLevel, StringFormat='{}{0:0}'}" Classes="number panelTitle" />
        </Grid>
        <Slider Minimum="{Binding AncMin}" Maximum="{Binding AncMax}" Value="{Binding AncLevel}" IsEnabled="{Binding CanControl}"
                TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Noise cancelling strength" />
        <TextBlock Text="Lower it if you hear pressure or hiss in quiet rooms" Classes="meta" />
      </StackPanel>
    </Border>
    <Border Classes="panel" IsVisible="{Binding ShowAmbientLevel}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Ambient sound level" Classes="panelTitle" />
          <TextBlock Grid.Column="1" Text="{Binding AmbientLevel, StringFormat='{}{0:0}'}" Classes="number panelTitle" />
        </Grid>
        <Slider Minimum="{Binding AmbientMin}" Maximum="{Binding AmbientMax}" Value="{Binding AmbientLevel}" IsEnabled="{Binding CanControl}"
                TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Ambient sound level" />
        <TextBlock Text="How much of your surroundings passes through" Classes="meta" />
      </StackPanel>
    </Border>

    <!-- Extras -->
    <Border Classes="panel" IsVisible="{Binding HasExtras}">
      <StackPanel Spacing="8">
        <TextBlock Text="Extras" Classes="panelTitle" />
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding ShowWind}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Wind noise reduction" />
            <TextBlock Text="Cuts the rumble of wind on the microphones" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding WindReduction}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Wind noise reduction" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding ShowConversation}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Conversation awareness" />
            <TextBlock Text="Lowers your audio and lets voices through when you start talking" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConversationAwareness}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Conversation awareness" />
        </Grid>
      </StackPanel>
    </Border>

  </StackPanel>

  <!-- Equalizer -->
  <Border Classes="panel" DataContext="{Binding Equalizer}" x:DataType="sound:EqualizerViewModel">
    <StackPanel Spacing="12">
      <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}" Margin="-16,-16,-16,0" />
      <StackPanel>
        <TextBlock Text="Equalizer" Classes="panelTitle" />
        <TextBlock Text="Presets stored on the earbuds" Classes="meta" IsVisible="{Binding !IsUnavailable}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Presets}" IsVisible="{Binding !IsUnavailable}" IsEnabled="{Binding CanControl}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sound:EqPresetOptionViewModel">
            <Button Classes="option" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                    AutomationProperties.Name="{Binding Label}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <PathIcon Grid.Column="1" Data="{StaticResource Icon.Check}" Width="14" Height="14" VerticalAlignment="Center"
                          Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding IsSelected}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding IsUnavailable}" Spacing="2">
        <TextBlock Text="Equalizer unavailable" />
        <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel IsVisible="{Binding !IsUnavailable}">
        <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="alert critical" IsVisible="{Binding HasError}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </Border>

  <!-- Share audio -->
  <Border Classes="panel" DataContext="{Binding Share}" x:DataType="sound:AudioShareViewModel">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Share audio" Classes="panelTitle" />
        <Border Grid.Column="1" Classes="chip" IsVisible="{Binding SharingSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding SharingSummary}" Classes="number" />
        </Border>
      </Grid>

      <!-- The source: everything shared is a copy of this output -->
      <Border Classes="strip" IsVisible="{Binding IsSupported}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="optionIcon on">
            <PathIcon Data="{Binding DefaultIconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="Playing on" Classes="meta" />
            <TextBlock Text="{Binding DefaultName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DefaultName}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLive}">
            <Ellipse Classes="liveDot" />
            <TextBlock Text="Live" Classes="meta" Foreground="{DynamicResource Samaat.Accent}" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Empty states -->
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsSupported}">
        <Border Classes="optionIcon">
          <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowNoRows}">
        <Border Classes="optionIcon">
          <PathIcon Data="{StaticResource Icon.Headphones}" Width="16" Height="16" />
        </Border>
        <TextBlock Grid.Column="1" Text="Connect another audio device to share to it or switch to it" Classes="meta" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sound:ShareTargetViewModel">
            <Border Classes="shareRow" Classes.sharing="{Binding IsSharing}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <Border Classes="optionIcon" Classes.on="{Binding IsSharing}">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding StateText}" Classes="meta" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="ghost" Command="{Binding SwitchHereCommand}" AutomationProperties.Name="{Binding SwitchLabel}"
                          IsVisible="{Binding $parent[ItemsControl].((sound:AudioShareViewModel)DataContext).CanSwitch}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource Icon.Switch}" Width="14" Height="14" />
                      <TextBlock Text="Switch here" FontSize="{StaticResource Samaat.FontSize.Meta}" />
                    </StackPanel>
                  </Button>
                  <ToggleSwitch Grid.Column="3" Classes="share" IsChecked="{Binding IsSharing}" IsEnabled="{Binding CanToggle}"
                                AutomationProperties.Name="{Binding ShareLabel}" AutomationProperties.HelpText="{Binding DisabledReason}"
                                ToolTip.Tip="{Binding DisabledReason}" />
                </Grid>
                <StackPanel Spacing="2" IsVisible="{Binding IsSharing}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Delay" />
                    <TextBlock Grid.Column="1" Text="{Binding DelayMs, StringFormat='{}{0} ms'}" Classes="number" />
                  </Grid>
                  <Slider Minimum="0" Maximum="500" Value="{Binding DelayMs}" TickFrequency="10" IsSnapToTickEnabled="True"
                          AutomationProperties.Name="{Binding DelayLabel}" />
                  <TextBlock Text="Add delay if this device plays ahead" Classes="meta" />
                </StackPanel>
                <Border Classes="alert" HorizontalAlignment="Left" IsVisible="{Binding HasStatus}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Up to 3 devices at once" Classes="meta" IsVisible="{Binding IsAtLimit}" />

      <Border Classes="alert" HorizontalAlignment="Left" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding HasRows}">
        <ToggleButton x:Name="HowToggle" Classes="disclosure" AutomationProperties.Name="How sharing works">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="How sharing works" Classes="meta" VerticalAlignment="Center" />
            <PathIcon Grid.Column="1" Classes="chevron" Data="{StaticResource Icon.Chevron}" />
          </Grid>
        </ToggleButton>
        <TextBlock Text="{Binding HelpText}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding #HowToggle.IsChecked}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
  </StackPanel>
</UserControl>
