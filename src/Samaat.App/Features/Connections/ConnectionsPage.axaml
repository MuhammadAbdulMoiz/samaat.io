<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conn="using:Samaat.App.Features.Connections"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:phone="using:Samaat.App.Features.Phone"
             xmlns:shared="using:Samaat.App.Shared"
             x:Class="Samaat.App.Features.Connections.ConnectionsPage"
             x:DataType="overview:DeviceViewModel">
  <!-- Links: this computer first (state, one action, one line of meaning), then every other device the earbuds know.
       Row anatomy follows the Share audio card: 32 px icon tile, name over meta, quiet actions on the right. -->
  <StackPanel Spacing="16">

    <!-- This computer -->
    <Border Classes="panel">
      <Panel>
        <StackPanel Spacing="12">
          <TextBlock Text="This computer" Classes="panelTitle" />

          <Border Classes="strip" MinHeight="48">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="optionIcon" Classes.on="{Binding IsConnected}" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Laptop}" Width="16" Height="16" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LinkStateText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LinkDetailText}" Classes="meta" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="primary" Command="{Binding ConnectCommand}" IsVisible="{Binding ShowConnect}"
                        AutomationProperties.Name="{Binding LinkAccessibleName}" AutomationProperties.HelpText="{Binding LinkDisabledReason}"
                        ToolTip.Tip="{Binding LinkDisabledReason}" ToolTip.ShowOnDisabled="True">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Link}" Width="14" Height="14" Foreground="{DynamicResource Samaat.OnAccent}" />
                    <TextBlock Text="Connect" />
                  </StackPanel>
                </Button>
                <Button Classes="subtle" Command="{Binding DisconnectCommand}" IsVisible="{Binding ShowDisconnect}"
                        AutomationProperties.Name="{Binding LinkAccessibleName}" AutomationProperties.HelpText="{Binding LinkDisabledReason}"
                        ToolTip.Tip="{Binding LinkDisabledReason}" ToolTip.ShowOnDisabled="True">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Disconnect}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Text}" />
                    <TextBlock Text="Disconnect" />
                  </StackPanel>
                </Button>
                <Button Classes="subtle" Command="{Binding OpenBluetoothSettingsCommand}" IsVisible="{Binding ShowSettingsFallback}"
                        AutomationProperties.Name="Open Bluetooth settings">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Settings}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Text}" />
                    <TextBlock Text="Bluetooth settings" />
                  </StackPanel>
                </Button>
              </Panel>
            </Grid>
          </Border>

          <Border Classes="alert critical" HorizontalAlignment="Left" IsVisible="{Binding Connections.HasError}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
              <TextBlock Text="{Binding Connections.ErrorText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
</StackPanel>
        <!-- Overlaid on the panel's top edge so it never shifts the content -->
        <ProgressBar Classes="busy" IsVisible="{Binding IsLinkBusy}" VerticalAlignment="Top" Margin="-16,-16,-16,0" />
      </Panel>
    </Border>

    <!-- Your phone: move these earbuds to a paired phone and back (any earbuds; see docs/modules/phone-handoff.md) -->
    <Border Classes="panel" IsVisible="{Binding PhoneMove, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8" DataContext="{Binding PhoneMove}" x:DataType="phone:PhoneMoveViewModel">
        <ProgressBar Classes="busy" IsVisible="{Binding ShowProgress}" Margin="-16,-16,-16,0" />
        <TextBlock Text="Your phone" Classes="panelTitle" />

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowSetup}">
          <TextBlock Text="{Binding SetupText}" Classes="meta" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="Pair a phone" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Targets}" IsVisible="{Binding HasPhones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="phone:PhoneTargetViewModel">
              <Border Classes="row host" CornerRadius="{StaticResource Samaat.Radius.Control}" Padding="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="optionIcon" Classes.on="{Binding IsOnline}" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Phone}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Classes="dot" Classes.on="{Binding IsOnline}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StateText}" Classes="meta" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="subtle" Content="Bring back here" Command="{Binding BringHereCommand}" IsVisible="{Binding CanBringHere}" />
                    <Button Classes="primary" Content="{Binding MoveText}" Command="{Binding MoveCommand}" IsVisible="{Binding CanMoveThere}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding ProgressText}" Classes="meta" IsVisible="{Binding ShowProgress}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ResultText}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding ShowSuccess}" />
        <Border Classes="alert critical" IsVisible="{Binding ShowFailure}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Devices: multipoint and every host the earbuds report, or an honest empty state -->
    <Border Classes="panel" DataContext="{Binding Connections}" x:DataType="conn:ConnectionsViewModel">
      <Panel>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Devices" Classes="panelTitle" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="chip" IsVisible="{Binding HasMultipoint}"
                    ToolTip.Tip="Devices connected now, out of how many the earbuds allow">
              <TextBlock Text="{Binding ConnectedSummary}" Classes="number" />
            </Border>
          </Grid>

          <!-- No multipoint protocol: say what we can't see and where to manage it -->
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !HasMultipoint}">
            <Border Classes="optionIcon" VerticalAlignment="Top">
              <PathIcon Data="{StaticResource Icon.Phone}" Width="16" Height="16" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding UnavailableTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <!-- Multipoint: a switch row, then the hosts -->
          <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding HasMultipoint}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Multipoint" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LimitText}" Classes="meta" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Classes="share" VerticalAlignment="Center"
                          IsChecked="{Binding MultipointEnabled}" IsEnabled="{Binding CanToggleMultipoint}"
                          AutomationProperties.Name="Multipoint" AutomationProperties.HelpText="{Binding MultipointDisabledReason}"
                          ToolTip.Tip="{Binding MultipointDisabledReason}" ToolTip.ShowOnDisabled="True" />
          </Grid>

          <Border Classes="divider" IsVisible="{Binding HasMultipoint}" />

          <ItemsControl ItemsSource="{Binding Hosts}" IsVisible="{Binding HasMultipoint}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="conn:HostViewModel">
                <Border Classes="shareRow" Classes.sharing="{Binding IsActive}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="optionIcon" Classes.on="{Binding IsActive}" VerticalAlignment="Center">
                      <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="chip" Padding="5,0" VerticalAlignment="Center" IsVisible="{Binding IsThisHost}">
                          <TextBlock Text="This computer" FontSize="{StaticResource Samaat.FontSize.Label}" />
                        </Border>
                        <TextBlock Text="{Binding StateText}" Classes="meta" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Classes="ghost" Command="{Binding DisconnectCommand}" IsVisible="{Binding CanDisconnect}"
                              AutomationProperties.Name="{Binding DisconnectLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{StaticResource Icon.Disconnect}" Width="14" Height="14" />
                          <TextBlock Text="Disconnect" FontSize="{StaticResource Samaat.FontSize.Meta}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost" Command="{Binding SwitchCommand}" IsVisible="{Binding CanSwitch}"
                              AutomationProperties.Name="{Binding SwitchLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{Binding SwitchIconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="14" Height="14" />
                          <TextBlock Text="{Binding SwitchText}" FontSize="{StaticResource Samaat.FontSize.Meta}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowNoHosts}">
            <Border Classes="optionIcon">
              <PathIcon Data="{StaticResource Icon.Bluetooth}" Width="16" Height="16" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="No other devices yet" FontWeight="SemiBold" />
              <TextBlock Text="Devices you pair these earbuds with appear here" Classes="meta" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding HostsNote}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding HasHostsNote}" />

          <!-- The limits we always state (docs/PLAN.md §8), one click away instead of a card of grey sentences -->
          <StackPanel>
            <ToggleButton x:Name="HowToggle" Classes="disclosure" AutomationProperties.Name="How links work">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="How links work" Classes="meta" VerticalAlignment="Center" />
                <PathIcon Grid.Column="1" Classes="chevron" Data="{StaticResource Icon.Chevron}" />
              </Grid>
            </ToggleButton>
            <TextBlock Text="{Binding HelpText}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding #HowToggle.IsChecked}" Margin="0,4,0,0" />
          </StackPanel>
</StackPanel>
        <!-- Overlaid on the panel's top edge so it never shifts the content -->
        <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" Margin="-16,-16,-16,0" />
      </Panel>
    </Border>
  </StackPanel>
</UserControl>
