<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conn="using:Samaat.App.Features.Connections"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             x:Class="Samaat.App.Features.Connections.ConnectionsPage"
             x:DataType="overview:DeviceViewModel">
  <StackPanel Spacing="16" DataContext="{Binding Connections}" x:DataType="conn:ConnectionsViewModel">

    <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

    <!-- Multipoint -->
    <Border Classes="panel" IsVisible="{Binding HasMultipoint}">
      <Grid ColumnDefinitions="*,Auto" MinHeight="40">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Multipoint" Classes="panelTitle" />
          <TextBlock Text="{Binding LimitText}" Classes="meta" />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MultipointEnabled}" IsEnabled="{Binding CanToggleMultipoint}"
                      AutomationProperties.Name="Multipoint" />
      </Grid>
    </Border>

    <Border Classes="alert critical" IsVisible="{Binding HasError}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
        <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Hosts: one panel, one row each -->
    <Border Classes="panel" IsVisible="{Binding HasMultipoint}">
      <StackPanel Spacing="8">
        <TextBlock Text="Connected devices" Classes="panelTitle" />
        <ItemsControl ItemsSource="{Binding Hosts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="conn:HostViewModel">
              <Border Classes="row host" Classes.active="{Binding IsActive}" CornerRadius="6" Padding="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="optionIcon" Classes.on="{Binding IsActive}" VerticalAlignment="Center">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <Border Classes="chip" Padding="6,1" IsVisible="{Binding IsThisHost}">
                        <TextBlock Text="This computer" FontSize="11" />
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StateText}" Classes="meta" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="subtle" Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding CanDisconnect}" />
                    <Button Classes="primary" Content="{Binding SwitchText}" Command="{Binding SwitchCommand}" IsVisible="{Binding CanSwitch}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Without a protocol that exposes multipoint, only this computer's link is known -->
    <Border Classes="panel" IsVisible="{Binding !HasMultipoint}">
      <StackPanel Spacing="8">
        <TextBlock Text="This computer" Classes="panelTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ThisComputerText}" />
        </StackPanel>
        <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Limits we always state (docs/PLAN.md §8) -->
    <Border Classes="panel">
      <StackPanel Spacing="6">
        <TextBlock Text="Good to know" Classes="panelTitle" />
        <TextBlock Classes="meta" TextWrapping="Wrap"
                   Text="Samaat can list and switch other devices only when your earbuds' own protocol allows it." />
        <TextBlock Classes="meta" TextWrapping="Wrap"
                   Text="To forget a device completely, remove the pairing in that device's Bluetooth settings." />
        <TextBlock Classes="meta" TextWrapping="Wrap"
                   Text="To disconnect this computer, use your system's Bluetooth settings." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
