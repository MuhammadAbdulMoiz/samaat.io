<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             xmlns:sound="using:Samaat.App.Features.Sound"
             xmlns:c="using:Samaat.App.Shared.Controls"
             xmlns:conn="using:Samaat.App.Features.Connections"
             x:Class="Samaat.App.Features.Overview.OverviewPage"
             x:DataType="overview:DeviceViewModel">
  <StackPanel Spacing="16">

    <!-- Battery: overall, left, right, case; "–" where the device reports nothing -->
    <Border Classes="panel">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Battery" Classes="panelTitle" />
            <TextBlock Text="{Binding BatteryReasonText}" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="subtle" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                  ToolTip.Tip="Ask the device for fresh battery levels" AutomationProperties.Name="Refresh battery">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Text}" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="alert" Classes.critical="{Binding AlertIsCritical}" IsVisible="{Binding HasAlert}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding AlertText}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding ShownFigures}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><c:AdaptiveColumns MinColumnWidth="116" MaxColumns="4" Spacing="16" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="overview:BatteryFigureViewModel">
              <StackPanel Classes="cell" Classes.unreported="{Binding !IsReported}" Spacing="4">
                <TextBlock Text="{Binding Label}" Classes="meta" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="figure" Text="{Binding Value}" />
                  <TextBlock Classes="unit" Text="{Binding Unit}" />
                </StackPanel>
                <ProgressBar Classes="level" Classes.low="{Binding IsLow}" Classes.critical="{Binding IsCritical}"
                             Minimum="0" Maximum="100" Value="{Binding Percent}" IsVisible="{Binding HasLevel}" />
                <TextBlock Text="{Binding Meta}" Classes="meta" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="meta" Text="{Binding LastUpdatedText, StringFormat='Updated {0}'}" />
      </StackPanel>
    </Border>

    <!-- Noise control -->
    <Border Classes="panel" DataContext="{Binding NoiseControl}" x:DataType="sound:NoiseControlViewModel">
      <StackPanel Spacing="12">
        <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="-16,-16,-16,0" />
        <TextBlock Text="Noise control" Classes="panelTitle" />
        <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding IsUnavailable}" />

        <Border Classes="tabWell" IsVisible="{Binding IsSelector}" IsEnabled="{Binding CanControl}">
          <ItemsControl ItemsSource="{Binding Modes}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sound:NoiseModeOptionViewModel">
                <Button Classes="tab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Description}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding IsToggle}">
          <TextBlock Text="Noise cancelling" VerticalAlignment="Center" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAncOn}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Noise cancelling" />
        </Grid>

        <WrapPanel IsVisible="{Binding !IsUnavailable}">
          <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border Classes="alert critical" IsVisible="{Binding HasError}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
              <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Links -->
    <Border Classes="panel" DataContext="{Binding Connections}" x:DataType="conn:ConnectionsViewModel">
      <StackPanel Spacing="8">
        <TextBlock Text="Links" Classes="panelTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ThisComputerText}" />
        </StackPanel>
        <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding LimitText}" IsVisible="{Binding HasMultipoint}" />
        <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding UnavailableText}" IsVisible="{Binding !HasMultipoint}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
