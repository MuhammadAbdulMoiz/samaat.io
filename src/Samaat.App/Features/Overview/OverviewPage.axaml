<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overview="using:Samaat.App.Features.Overview"
             xmlns:shared="using:Samaat.App.Shared"
             xmlns:sound="using:Samaat.App.Features.Sound"
             xmlns:c="using:Samaat.App.Shared.Controls"
             xmlns:conn="using:Samaat.App.Features.Connections"
             xmlns:shell="using:Samaat.App.Shell"
             xmlns:parts="using:Samaat.App.Shared.Parts"
             x:Class="Samaat.App.Features.Overview.OverviewPage"
             x:DataType="overview:DeviceViewModel">
  <!-- Overview: battery tiles first, then one row each for noise control and links, each leading to its tab -->
  <StackPanel Spacing="16">

    <!-- Battery: overall, left, right, case; "–" where the device reports nothing -->
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Battery" Classes="panelTitle" />
            <TextBlock Text="{Binding BatteryReasonText}" Classes="meta" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="meta" Text="{Binding LastUpdatedText, StringFormat='Updated {0}'}" VerticalAlignment="Center" Margin="12,0,8,0" />
          <Button Grid.Column="2" Classes="icon" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Ask the device for fresh battery levels" AutomationProperties.Name="Refresh battery">
            <PathIcon Data="{StaticResource Icon.Refresh}" />
          </Button>
        </Grid>

        <Border Classes="alert" Classes.critical="{Binding AlertIsCritical}" IsVisible="{Binding HasAlert}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
            <TextBlock Text="{Binding AlertText}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>

        <parts:BatteryFigures />
      </StackPanel>
    </Border>

    <!-- Noise control -->
    <Border Classes="panel" DataContext="{Binding NoiseControl}" x:DataType="sound:NoiseControlViewModel">
      <Panel>
        <StackPanel Spacing="12">
          <TextBlock Text="Noise control" Classes="panelTitle" />

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsUnavailable}">
            <Border Classes="optionIcon" VerticalAlignment="Top">
              <PathIcon Data="{StaticResource Icon.NoiseCancelling}" Width="16" Height="16" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Not available for this model yet" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding UnavailableText}" Classes="meta" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Border Classes="tabWell" IsVisible="{Binding IsSelector}" IsEnabled="{Binding CanControl}">
            <ItemsControl ItemsSource="{Binding Modes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sound:NoiseModeOptionViewModel">
                  <Button Classes="tab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                          AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{Binding IconKey, Converter={x:Static shared:Converters.IconByKey}}" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Grid ColumnDefinitions="*,Auto" MinHeight="40" IsVisible="{Binding IsToggle}">
            <TextBlock Text="Noise cancelling" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" Classes="share" IsChecked="{Binding IsAncOn}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Noise cancelling" />
          </Grid>

          <WrapPanel IsVisible="{Binding !IsUnavailable}">
            <TextBlock Text="{Binding StatusText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Border Classes="alert critical" IsVisible="{Binding HasError}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14" />
                <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </WrapPanel>
        </StackPanel>
        <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" Margin="-16,-16,-16,0" />
      </Panel>
    </Border>

    <!-- Links: this computer's state in one row, and the way to the Links tab -->
    <Border Classes="panel" DataContext="{Binding Connections}" x:DataType="conn:ConnectionsViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="Links" Classes="panelTitle" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="optionIcon" Classes.on="{Binding IsConnected}" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Laptop}" Width="16" Height="16" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ThisComputerText}" FontWeight="SemiBold" />
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding LimitText}" IsVisible="{Binding HasMultipoint}" />
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding UnavailableText}" IsVisible="{Binding !HasMultipoint}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center" AutomationProperties.Name="Open Links"
                  Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).NavigateCommand}"
                  CommandParameter="{x:Static shell:AppSection.Connections}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Manage" FontSize="12" Foreground="{DynamicResource Samaat.Muted}" />
              <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Muted}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
