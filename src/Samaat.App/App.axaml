<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Samaat.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Samaat.UI/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://Samaat.UI/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Samaat.UI/Styles/Metrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="DisplayFont">avares://Samaat.UI/Assets/Fonts#Space Grotesk</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Samaat.UI/Styles/Artwork.axaml" />
    <StyleInclude Source="avares://Samaat/Styles/Base.axaml" />
    <StyleInclude Source="avares://Samaat/Styles/Shell.axaml" />
    <StyleInclude Source="avares://Samaat/Styles/Gauges.axaml" />
    <StyleInclude Source="avares://Samaat/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
