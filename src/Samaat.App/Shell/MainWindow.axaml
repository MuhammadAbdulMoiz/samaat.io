<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Samaat.App.Shell"
        xmlns:c="using:Samaat.App.Shared.Controls"
        xmlns:overview="using:Samaat.App.Features.Overview"
        xmlns:sound="using:Samaat.App.Features.Sound"
        xmlns:conn="using:Samaat.App.Features.Connections"
        xmlns:info="using:Samaat.App.Features.Info"
        xmlns:details="using:Samaat.App.Features.Details"
        xmlns:settings="using:Samaat.App.Features.Settings"
        x:Class="Samaat.App.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="Samaat"
        Width="1180" Height="780" MinWidth="640" MinHeight="520">
  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar: brand, devices, then alerts, refresh and settings -->
    <Border x:Name="Sidebar" Classes="sidebar" Classes.compact="{Binding IsSidebarCompact}">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Classes="brand" Orientation="Horizontal" Spacing="10" Margin="0,4,0,20">
          <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Samaat.Accent}" ToolTip.Tip="Samaat">
            <TextBlock Text="S" Classes="display" FontSize="18" Foreground="{DynamicResource Samaat.OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="full display" Text="Samaat" FontSize="18" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
          <Border Classes="chip" IsVisible="{Binding ModeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding ModeText}" AutomationProperties.Name="Simulation">
            <StackPanel Classes="chipRow" Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Sparkle}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Warn}" />
              <TextBlock Classes="full" Text="Simulation" />
            </StackPanel>
          </Border>
          <Button Classes="alertChip" IsVisible="{Binding HasAlertingDevices}" Command="{Binding ShowAlertingDeviceCommand}"
                  ToolTip.Tip="Show the device with a low battery" AutomationProperties.Name="{Binding AlertCountText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" />
              <TextBlock Classes="full" Text="{Binding AlertCountText}" />
              <TextBlock Classes="compactOnly" Text="{Binding AlertingDeviceCount}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Refresh devices" AutomationProperties.Name="Refresh devices">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Refresh}" />
              <TextBlock Classes="full" Text="Refresh devices" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsSettings}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Settings}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Settings}" />
              <TextBlock Classes="full" Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- A Grid, not a StackPanel, so the list gets a finite height and scrolls instead of covering Settings. -->
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <TextBlock Classes="full meta" Text="Your devices" Margin="10,0,0,0" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Devices}" AutomationProperties.Name="Your devices">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="overview:DeviceViewModel">
                  <Button Classes="deviceRow" Classes.current="{Binding IsCurrent}" AutomationProperties.Name="{Binding RowAccessibleText}"
                          ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((shell:MainWindowViewModel)DataContext).SelectDeviceCommand}"
                          CommandParameter="{Binding}">
                    <Panel>
                      <Grid Classes="full" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="name" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="number" Text="{Binding SummaryShort}" Margin="8,0,0,0" />
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                          <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                          <TextBlock Classes="meta" Text="{Binding ConnectionText}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Classes="compactOnly" Spacing="2" HorizontalAlignment="Center">
                        <Border Classes="initials">
                          <TextBlock Classes="number" Text="{Binding Initials}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="meta number" Text="{Binding SummaryShort}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <ScrollViewer>
        <Panel Margin="24">

          <!-- Empty state -->
          <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" Margin="0,80,0,0" Spacing="12" MaxWidth="420">
            <PathIcon Data="{StaticResource Icon.Headphones}" Width="48" Height="48" Foreground="{DynamicResource Samaat.Faint}" />
            <TextBlock Text="No earbuds yet" Classes="title" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <!-- Device page: rail on the left (above the workspace when narrow), tabs and panels on the right -->
          <c:SplitPanel x:Name="DeviceLayout" IsVisible="{Binding ShowDevicePage}" SecondaryFirst="True" MinPrimaryWidth="484" Spacing="16">
            <StackPanel Spacing="16">
              <Border Classes="tabWell">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="tab" Classes.selected="{Binding IsOverview}" Content="Overview" AutomationProperties.Name="Overview"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Overview}" />
                  <Button Classes="tab" Classes.selected="{Binding IsSound}" Content="Sound" AutomationProperties.Name="Sound"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Sound}" />
                  <Button Classes="tab" Classes.selected="{Binding IsConnections}" Content="Links" AutomationProperties.Name="Links"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Connections}" />
                  <Button Classes="tab" Classes.selected="{Binding IsDetails}" Content="Details" AutomationProperties.Name="Details"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Details}" />
                  <Button Classes="tab" Classes.selected="{Binding IsInfo}" Content="Diagnostics" AutomationProperties.Name="Diagnostics"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Info}" />
                </StackPanel>
              </Border>
              <TransitioningContentControl x:Name="PageHost" Content="{Binding DevicePage}">
                <TransitioningContentControl.PageTransition>
                  <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
                <TransitioningContentControl.DataTemplates>
                  <DataTemplate DataType="shell:OverviewPageModel"><overview:OverviewPage DataContext="{Binding Device}" /></DataTemplate>
                  <DataTemplate DataType="shell:SoundPageModel"><sound:SoundPage DataContext="{Binding Device}" /></DataTemplate>
                  <DataTemplate DataType="shell:ConnectionsPageModel"><conn:ConnectionsPage DataContext="{Binding Device}" /></DataTemplate>
                  <DataTemplate DataType="shell:InfoPageModel"><info:InfoPage DataContext="{Binding Device}" /></DataTemplate>
                  <DataTemplate DataType="shell:DetailsPageModel"><details:BluetoothDetailsPage DataContext="{Binding Device}" /></DataTemplate>
                </TransitioningContentControl.DataTemplates>
              </TransitioningContentControl>
            </StackPanel>

            <StackPanel Width="260" Spacing="16" DataContext="{Binding SelectedDevice}" x:DataType="overview:DeviceViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}" Classes="title" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>

              <!-- The artwork sits on the canvas: no card -->
              <Border Classes="stage" Height="216">
                <Panel AutomationProperties.Name="{Binding ArtworkLabel}">
                  <c:SoundWaves Stroke="{DynamicResource Samaat.Wave}" Opacity="0.14" Count="8" Origin="50%,50%" />
                  <!-- Split photo: each bud and the case with its own level, buds above the case as in the product photo -->
                  <ItemsControl Classes="artworkParts" ItemsSource="{Binding ArtworkParts}" IsVisible="{Binding ShowArtworkParts}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="overview:ArtworkPartViewModel">
                        <StackPanel Classes="artworkPart" Classes.missing="{Binding !Figure.HasLevel}" Spacing="2"
                                    AutomationProperties.Name="{Binding Figure.AccessibleText}" ToolTip.Tip="{Binding Figure.AccessibleText}">
                          <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.BatteryCharge}" Width="14" Height="14" IsVisible="{Binding Figure.IsCharging}"
                                      Foreground="{DynamicResource Samaat.Accent}" VerticalAlignment="Center" />
                            <TextBlock Classes="number" Classes.charging="{Binding Figure.IsCharging}" Text="{Binding Figure.Value}" />
                            <TextBlock Classes="meta" Text="{Binding Figure.Unit}" VerticalAlignment="Bottom" />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Unknown look, separate pieces: faint left bud, right bud and case, same layout as the split photo -->
                  <Grid Classes="unknownPieces" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowUnknownPieces}">
                    <StackPanel Classes="artworkPart" Classes.missing="{Binding !Figures[1].HasLevel}" Spacing="2"
                                AutomationProperties.Name="{Binding Figures[1].AccessibleText}" ToolTip.Tip="{Binding Figures[1].AccessibleText}">
                      <Panel Height="64" HorizontalAlignment="Center">
                        <Viewbox Height="64"><Canvas Width="40" Height="56"><Path Data="{StaticResource Glyph.Bud}" Classes="unknownShape" /></Canvas></Viewbox>
                        <Border Classes="unknownBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="?" /></Border>
                      </Panel>
                      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Classes="number" Text="{Binding Figures[1].Value}" />
                        <TextBlock Classes="meta" Text="{Binding Figures[1].Unit}" VerticalAlignment="Bottom" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="artworkPart" Classes.missing="{Binding !Figures[2].HasLevel}" Spacing="2"
                                AutomationProperties.Name="{Binding Figures[2].AccessibleText}" ToolTip.Tip="{Binding Figures[2].AccessibleText}">
                      <Panel Height="64" HorizontalAlignment="Center">
                        <Viewbox Height="64" RenderTransform="scaleX(-1)"><Canvas Width="40" Height="56"><Path Data="{StaticResource Glyph.Bud}" Classes="unknownShape" /></Canvas></Viewbox>
                        <Border Classes="unknownBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="?" /></Border>
                      </Panel>
                      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Classes="number" Text="{Binding Figures[2].Value}" />
                        <TextBlock Classes="meta" Text="{Binding Figures[2].Unit}" VerticalAlignment="Bottom" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Classes="artworkPart" Classes.missing="{Binding !Figures[3].HasLevel}" Spacing="2"
                                AutomationProperties.Name="{Binding Figures[3].AccessibleText}" ToolTip.Tip="{Binding Figures[3].AccessibleText}">
                      <Panel Height="50" HorizontalAlignment="Center">
                        <Viewbox Height="50"><Canvas Width="64" Height="48"><Path Data="{StaticResource Glyph.Case}" Classes="unknownShape" /></Canvas></Viewbox>
                        <Border Classes="unknownBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="?" /></Border>
                      </Panel>
                      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Classes="number" Text="{Binding Figures[3].Value}" />
                        <TextBlock Classes="meta" Text="{Binding Figures[3].Unit}" VerticalAlignment="Bottom" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <Panel Width="176" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!ShowArtworkParts" />
                        <Binding Path="!ShowUnknownPieces" />
                      </MultiBinding>
                    </Panel.IsVisible>
                    <c:BatteryRing Value="{Binding SummaryPercent}" HasValue="{Binding HasSummary}" Thickness="6"
                                   Classes.low="{Binding SummaryIsLow}" Classes.critical="{Binding Figures[0].IsCritical}" />
                    <Image IsVisible="{Binding HasArtworkImage}" Source="{Binding ArtworkImage}" Width="118" Height="118"
                           Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <!-- Unknown look, single: one faint silhouette with a "?" badge -->
                    <Panel Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowUnknownSingle}">
                      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasBuds}">
                        <Viewbox Width="40"><Canvas Width="40" Height="56"><Path Data="{StaticResource Glyph.Bud}" Classes="unknownShape" /></Canvas></Viewbox>
                        <Viewbox Width="40" RenderTransform="scaleX(-1)"><Canvas Width="40" Height="56"><Path Data="{StaticResource Glyph.Bud}" Classes="unknownShape" /></Canvas></Viewbox>
                      </StackPanel>
                      <PathIcon Data="{StaticResource Icon.Headphones}" Width="84" Height="84" Foreground="{DynamicResource Samaat.Faint}" Opacity="0.55"
                                IsVisible="{Binding !HasBuds}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Border Classes="unknownBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="?" /></Border>
                    </Panel>
                  </Panel>
                </Panel>
              </Border>
              <Button Classes="ghost" Content="Change look" HorizontalAlignment="Center" Margin="0,-10,0,0" FontSize="12" Foreground="{DynamicResource Samaat.Muted}"
                      AutomationProperties.Name="Change look" ToolTip.Tip="Change the artwork for this device">
                <Button.Flyout>
                  <MenuFlyout Placement="Bottom" ItemsSource="{Binding LookOptions}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme x:DataType="overview:LookOptionViewModel" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Command" Value="{Binding Select}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Icon">
                          <Template>
                            <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}"
                                      IsVisible="{Binding IsSelected}" />
                          </Template>
                        </Setter>
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <StackPanel Spacing="2" AutomationProperties.Name="{Binding BatteryAccessibleText}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="figure" Text="{Binding SummaryFigure}" />
                  <TextBlock Classes="unit" Text="{Binding SummaryUnit}" />
                </StackPanel>
                <TextBlock Classes="meta" Text="{Binding BatterySourceMeta}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding TierDescription}">
                <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding StatusLineText}" />
              </StackPanel>
              <Button Classes="primary" Content="Connect" HorizontalAlignment="Center" Command="{Binding ConnectCommand}" IsVisible="{Binding ShowConnect}"
                      AutomationProperties.Name="{Binding LinkAccessibleName}" />
            </StackPanel>
          </c:SplitPanel>

          <Panel IsVisible="{Binding IsSettings}"><settings:SettingsPage DataContext="{Binding Settings}" /></Panel>
        </Panel>
      </ScrollViewer>

      <!-- Toasts: battery alerts from any device -->
      <ItemsControl ItemsSource="{Binding Alerts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" Width="340">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="toast" Margin="0,8,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{DynamicResource Samaat.Warn}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss alert"
                        Command="{Binding $parent[ItemsControl].((shell:MainWindowViewModel)DataContext).DismissAlertCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Muted}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
