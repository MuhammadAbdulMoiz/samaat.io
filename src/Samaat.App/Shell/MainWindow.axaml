<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Samaat.App.Shell"
        xmlns:c="using:Samaat.App.Shared.Controls"
        xmlns:uilogo="using:Samaat.UI"
        xmlns:overview="using:Samaat.App.Features.Overview"
        xmlns:sound="using:Samaat.App.Features.Sound"
        xmlns:conn="using:Samaat.App.Features.Connections"
        xmlns:info="using:Samaat.App.Features.Info"
        xmlns:details="using:Samaat.App.Features.Details"
        xmlns:settings="using:Samaat.App.Features.Settings"
        xmlns:parts="using:Samaat.App.Shared.Parts"
        xmlns:views="using:Samaat.App.Shell.Views"
        xmlns:core="using:Samaat.Core.Settings"
        x:Class="Samaat.App.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="Samaat"
        Width="1180" Height="780" MinWidth="640" MinHeight="520">
  <!-- Layouts: Ctrl+Shift+1 Studio, 2 Focus, 3 Glance -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+D1" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Studio}" />
    <KeyBinding Gesture="Ctrl+Shift+D2" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Focus}" />
    <KeyBinding Gesture="Ctrl+Shift+D3" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Glance}" />
  </Window.KeyBindings>

  <!-- Device pages, for Studio's tab host and Focus's "More" pages alike -->
  <Window.DataTemplates>
    <DataTemplate DataType="shell:OverviewPageModel"><overview:OverviewPage DataContext="{Binding Device}" /></DataTemplate>
    <DataTemplate DataType="shell:SoundPageModel"><sound:SoundPage DataContext="{Binding Device}" /></DataTemplate>
    <DataTemplate DataType="shell:ConnectionsPageModel"><conn:ConnectionsPage DataContext="{Binding Device}" /></DataTemplate>
    <DataTemplate DataType="shell:InfoPageModel"><info:InfoPage DataContext="{Binding Device}" /></DataTemplate>
    <DataTemplate DataType="shell:DetailsPageModel"><details:BluetoothDetailsPage DataContext="{Binding Device}" /></DataTemplate>
  </Window.DataTemplates>

  <Window.Resources>
    <!-- The fixed logo (Samaat.UI.Logo, the app icon): it doesn't change with the accent preset -->
    <Image x:Key="BrandMark" x:Shared="False" Source="{x:Static uilogo:Logo.Image}" Width="40" Height="40"
           ToolTip.Tip="Samaat" AutomationProperties.Name="Samaat" />

  </Window.Resources>

  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar: brand, devices, then alerts, refresh and settings -->
    <Border x:Name="Sidebar" Classes="sidebar" Classes.compact="{Binding IsSidebarCompact}">
      <DockPanel Margin="12">
        <!-- Brand: the app mark in an accent halo, the name and what it is, and the collapse toggle -->
        <Panel DockPanel.Dock="Top" Margin="0,2,0,20">
          <Grid Classes="full" ColumnDefinitions="Auto,*,Auto">
            <ContentControl Content="{StaticResource BrandMark}" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="display" Text="Samaat" FontSize="{StaticResource Samaat.FontSize.Brand}" />
              <TextBlock Classes="meta" Text="Earbud companion" FontSize="{StaticResource Samaat.FontSize.Label}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon sidebarToggle" Command="{Binding ToggleSidebarCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding SidebarToggleText}" AutomationProperties.Name="{Binding SidebarToggleText}">
              <PathIcon Data="{StaticResource Icon.Menu}" />
            </Button>
          </Grid>
          <StackPanel Classes="compactOnly" Spacing="10" HorizontalAlignment="Center">
            <ContentControl Content="{StaticResource BrandMark}" HorizontalAlignment="Center" />
            <Button Classes="icon sidebarToggle" Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Center"
                    ToolTip.Tip="{Binding SidebarToggleText}" AutomationProperties.Name="{Binding SidebarToggleText}">
              <PathIcon Data="{StaticResource Icon.Menu}" />
            </Button>
          </StackPanel>
        </Panel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
          <Border Classes="chip" IsVisible="{Binding ModeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding ModeText}" AutomationProperties.Name="Simulation">
            <StackPanel Classes="chipRow" Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Sparkle}" Width="14" Height="14" Foreground="{DynamicResource Samaat.Warn}" />
              <TextBlock Classes="full" Text="Simulation" />
            </StackPanel>
          </Border>
          <Button Classes="alertChip" IsVisible="{Binding HasAlertingDevices}" Command="{Binding ShowAlertingDeviceCommand}"
                  ToolTip.Tip="Show the device with a low battery" AutomationProperties.Name="{Binding AlertCountText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" />
              <TextBlock Classes="full" Text="{Binding AlertCountText}" />
              <TextBlock Classes="compactOnly" Text="{Binding AlertingDeviceCount}" />
            </StackPanel>
          </Button>
          <!-- Refresh, with the device filter beside it: Connected (default), Recent or All paired -->
          <DockPanel Classes="refreshRow">
            <Button x:Name="DeviceFilterButton" Classes="nav filterButton" ToolTip.Tip="{Binding DeviceFilterButtonName}"
                    AutomationProperties.Name="{Binding DeviceFilterButtonName}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource Icon.Filter}" />
                <PathIcon Classes="full" Data="{StaticResource Icon.Chevron}" Width="10" Height="10" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                  <MenuItem Header="Connected" Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static core:DeviceFilter.Connected}"
                            AutomationProperties.Name="Show connected devices">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsConnectedFilter}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Recent" Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static core:DeviceFilter.Recent}"
                            AutomationProperties.Name="Show devices connected in the last 7 days">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsRecentFilter}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="All paired" Command="{Binding SetDeviceFilterCommand}" CommandParameter="{x:Static core:DeviceFilter.Paired}"
                            AutomationProperties.Name="Show all paired devices">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsPairedFilter}" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="nav" Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Refresh devices" AutomationProperties.Name="Refresh devices">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource Icon.Refresh}" />
                <TextBlock Classes="full" Text="Refresh devices" />
              </StackPanel>
            </Button>
          </DockPanel>
          <!-- Layout: Studio (default), Focus or Glance -->
          <Button x:Name="LayoutButton" Classes="nav" ToolTip.Tip="{Binding LayoutButtonName}" AutomationProperties.Name="{Binding LayoutButtonName}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource Icon.Layout}" />
              <TextBlock Grid.Column="1" Classes="full" Text="Layout" Margin="10,0,0,0" />
              <TextBlock Grid.Column="2" Classes="full meta" Text="{Binding Settings.DashboardName}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <MenuFlyout Placement="RightEdgeAlignedBottom">
                <MenuItem Header="Studio" InputGesture="Ctrl+Shift+1" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Studio}"
                          AutomationProperties.Name="Studio layout: every control, one device at a time">
                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsStudioView}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Focus" InputGesture="Ctrl+Shift+2" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Focus}"
                          AutomationProperties.Name="Focus layout: one device, big and simple">
                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsFocusView}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Glance" InputGesture="Ctrl+Shift+3" Command="{Binding SetDashboardCommand}" CommandParameter="{x:Static core:DashboardView.Glance}"
                          AutomationProperties.Name="Glance layout: every device's battery, in a small window">
                  <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}" IsVisible="{Binding Settings.IsGlanceView}" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="nav" Classes.current="{Binding IsSettings}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Settings}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource Icon.Settings}" />
              <TextBlock Classes="full" Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- A Grid, not a StackPanel, so the list gets a finite height and scrolls instead of covering Settings. -->
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Classes="full" Spacing="4" Margin="10,0,0,0">
            <TextBlock Classes="meta" Text="{Binding DeviceListTitle}" />
            <TextBlock Classes="meta" Text="None right now" IsVisible="{Binding !HasVisibleDevices}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleDevices}" AutomationProperties.Name="{Binding DeviceListTitle}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="overview:DeviceViewModel">
                  <Button Classes="deviceRow" Classes.current="{Binding IsCurrent}" AutomationProperties.Name="{Binding RowAccessibleText}"
                          ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[ItemsControl].((shell:MainWindowViewModel)DataContext).SelectDeviceCommand}"
                          CommandParameter="{Binding}">
                    <Panel>
                      <Grid Classes="full" ColumnDefinitions="Auto,*">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceThumb}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Classes="name" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="meta" Text="{Binding ConnectionText}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Classes="number" Text="{Binding SummaryShort}" FontSize="{StaticResource Samaat.FontSize.Meta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                      <StackPanel Classes="compactOnly" Spacing="4" HorizontalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceThumb}" HorizontalAlignment="Center" />
                        <TextBlock Classes="meta number" Text="{Binding SummaryShort}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <ScrollViewer>
        <Panel Margin="24">

          <!-- Empty state -->
          <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" Margin="0,80,0,0" Spacing="12" MaxWidth="420">
            <PathIcon Data="{StaticResource Icon.Headphones}" Width="48" Height="48" Foreground="{DynamicResource Samaat.Faint}" />
            <TextBlock Text="No earbuds yet" Classes="title" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <!-- Device page: rail on the left (above the workspace when narrow), tabs and panels on the right -->
          <c:SplitPanel x:Name="DeviceLayout" IsVisible="{Binding ShowStudio}" AutomationProperties.Name="Studio layout" SecondaryFirst="True" MinPrimaryWidth="484" Spacing="16">
            <StackPanel Spacing="16">
              <Border Classes="tabWell">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Classes="tab" Classes.selected="{Binding IsOverview}" Content="Overview" AutomationProperties.Name="Overview"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Overview}" />
                  <Button Classes="tab" Classes.selected="{Binding IsSound}" Content="Sound" AutomationProperties.Name="Sound"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Sound}" />
                  <Button Classes="tab" Classes.selected="{Binding IsConnections}" Content="Links" AutomationProperties.Name="Links"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Connections}" />
                  <Button Classes="tab" Classes.selected="{Binding IsDetails}" Content="Details" AutomationProperties.Name="Details"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Details}" />
                  <Button Classes="tab" Classes.selected="{Binding IsInfo}" Content="Diagnostics" AutomationProperties.Name="Diagnostics"
                          Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppSection.Info}" />
                </StackPanel>
              </Border>
              <TransitioningContentControl x:Name="PageHost" Content="{Binding DevicePage}">
                <TransitioningContentControl.PageTransition>
                  <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
              </TransitioningContentControl>
            </StackPanel>

            <StackPanel Width="260" Spacing="16" DataContext="{Binding SelectedDevice}" x:DataType="overview:DeviceViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}" Classes="title" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>

              <!-- The artwork sits on the canvas: no card -->
              <parts:DeviceStage />
              <Button Classes="ghost" Content="Change look" HorizontalAlignment="Center" Margin="0,-10,0,0" FontSize="{StaticResource Samaat.FontSize.Meta}" Foreground="{DynamicResource Samaat.Muted}"
                      AutomationProperties.Name="Change look" ToolTip.Tip="Change the artwork for this device">
                <Button.Flyout>
                  <MenuFlyout Placement="Bottom" ItemsSource="{Binding LookOptions}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme x:DataType="overview:LookOptionViewModel" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Command" Value="{Binding Select}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <Setter Property="Icon">
                          <Template>
                            <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Accent}"
                                      IsVisible="{Binding IsSelected}" />
                          </Template>
                        </Setter>
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <StackPanel Spacing="2" AutomationProperties.Name="{Binding BatteryAccessibleText}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="figure" Text="{Binding SummaryFigure}" />
                  <TextBlock Classes="unit" Text="{Binding SummaryUnit}" />
                </StackPanel>
                <TextBlock Classes="meta" Text="{Binding BatterySourceMeta}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding TierDescription}">
                <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding StatusLineText}" />
              </StackPanel>
              <Button Classes="primary" Content="Connect" HorizontalAlignment="Center" Command="{Binding ConnectCommand}" IsVisible="{Binding ShowConnect}"
                      AutomationProperties.Name="{Binding LinkAccessibleName}" />
            </StackPanel>
          </c:SplitPanel>

          <views:FocusView x:Name="FocusLayout" IsVisible="{Binding ShowFocus}" />
          <views:GlanceView x:Name="GlanceLayout" IsVisible="{Binding ShowGlance}" />

          <!-- Devices exist but the filter hides them all -->
          <StackPanel x:Name="FilterEmptyState" IsVisible="{Binding ShowFilterEmpty}" HorizontalAlignment="Center" Margin="0,80,0,0" Spacing="12" MaxWidth="420">
            <PathIcon Data="{StaticResource Icon.Bluetooth}" Width="48" Height="48" Foreground="{DynamicResource Samaat.Faint}" />
            <TextBlock Text="{Binding FilterEmptyTitle}" Classes="title" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FilterEmptyDetail}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Classes="primary" Content="Show all paired devices" Command="{Binding SetDeviceFilterCommand}"
                      CommandParameter="{x:Static core:DeviceFilter.Paired}" AutomationProperties.Name="Show all paired devices" />
              <Button Classes="subtle" Content="Refresh" Command="{Binding RefreshDevicesCommand}" AutomationProperties.Name="Refresh devices" />
            </StackPanel>
          </StackPanel>

          <Panel IsVisible="{Binding IsSettings}"><settings:SettingsPage DataContext="{Binding Settings}" /></Panel>
        </Panel>
      </ScrollViewer>

      <!-- Toasts: battery alerts from any device -->
      <ItemsControl ItemsSource="{Binding Alerts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" Width="340">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="toast" Margin="0,8,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="16" Height="16" Foreground="{DynamicResource Samaat.Warn}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost" MinWidth="32" MinHeight="32" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss alert"
                        Command="{Binding $parent[ItemsControl].((shell:MainWindowViewModel)DataContext).DismissAlertCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" Foreground="{DynamicResource Samaat.Muted}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
