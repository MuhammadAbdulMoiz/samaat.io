<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Android app: hosts Samaat.Mobile's UI and wires in the Android platform layer.
         Built only by the Android CI job (it needs the Android workload and SDK); see Samaat.Mobile.slnx. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>io.samaat.app</ApplicationId>
    <ApplicationTitle>Samaat</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- See Samaat.Platform.Android.csproj: Android bindings warn a lot and this project only builds in its own CI job. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Core's device catalog and settings use reflection-based System.Text.Json, which trimmed builds turn off by default. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop's device catalog, profiles and artwork photos; extracted on start (AndroidHost.ExtractDevices). -->
    <AndroidAsset Include="..\..\devices\**\*.json" LinkBase="Assets\devices" />
    <AndroidAsset Include="..\..\devices\**\*.png" LinkBase="Assets\devices" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Mobile\Samaat.Mobile.csproj" />
    <ProjectReference Include="..\Samaat.Platform.Android\Samaat.Platform.Android.csproj" />
  </ItemGroup>
</Project>
