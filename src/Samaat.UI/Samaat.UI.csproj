<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The design system both apps draw from: tokens, icons, fonts and the signature controls (battery ring, sound waves).
         One copy, so the desktop and the phone can't drift apart (docs/design/ui-audit.md). -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
