<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;$(SamaatWindowsTfm)</TargetFrameworks>
    <AssemblyName>samaat-cli</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);SAMAAT_WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Core\Samaat.Core.csproj" />
    <ProjectReference Include="..\Samaat.Simulator\Samaat.Simulator.csproj" />
    <ProjectReference Include="..\Samaat.Platform.Windows\Samaat.Platform.Windows.csproj" Condition="'$(TargetFramework)' != 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\devices\**\*.json" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
