<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <!-- Android's bindings are noisy with platform-version and nullability warnings, and this project is only built in
         the Android CI job (no Android SDK on the default runners), so warnings stay warnings here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Core\Samaat.Core.csproj" />
    <ProjectReference Include="..\Samaat.Transport\Samaat.Transport.csproj" />
    <ProjectReference Include="..\Samaat.Handoff\Samaat.Handoff.csproj" />
    <ProjectReference Include="..\Samaat.Protocols.Standard\Samaat.Protocols.Standard.csproj" />
  </ItemGroup>
</Project>
