<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The phone app in a phone-sized window on a computer, with simulated earbuds and the real network link, so it can
         pair with the desktop app on the same laptop or network. For trying the phone UI without a phone. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Samaat.PhonePreview</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Mobile\Samaat.Mobile.csproj" />
  </ItemGroup>
</Project>
